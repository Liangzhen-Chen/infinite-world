+// 只认整段除数就是这个数：抽出的操作数去掉外层括号后恰为该数，且其后（跳过空白）不紧跟英文名或数字
+// （"除以一万倍的 X""除以一万的 j 次方""除以 X 一万次"的除数都不是纯常数，照常判）。不设例外名单。
+const CN_NUM = /^[〇零一二三四五六七八九十百千万亿两]+$/;
+function literalConstDivisor(s, divisor, end) {
+  const d = stripOuter(divisor).replace(/\s/g, '');
+  const arabic = /^(?:[1-9]\d*(?:\.\d+)?|0\.\d*[1-9]\d*)$/.test(d);
+  const chinese = CN_NUM.test(d) && /[一二三四五六七八九十百千万亿两]/.test(d);
+  if (!arabic && !chinese) return false;
+  return !/^[A-Za-z_\d]/.test(s.slice(end).trimStart());
+}
