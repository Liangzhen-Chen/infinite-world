 },
 "class_cheese.appearance.2": {
  "label": "有的乳酪气味特别冲"
 },
 "class_copper.appearance.0": {
  "label": "新鲜表面呈粉橙色"
 },
 "class_copper.appearance.1": {
  "label": "红橙色金属光泽"
 },
 "class_copper.appearance.2": {
  "label": "暴露在空气中会带上红色的失泽层"
 },
 "class_copper.appearance.3": {
