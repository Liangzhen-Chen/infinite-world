 "class_brass.appearance.3": {
  "label": "铜与硫反应生成褐色以至黑色的硫化铜表层"
 },
 "class_brass.appearance.4": {
  "label": "硫化铜层若常接触弱酸性水（如城市雨水），可在空气中氧化成绿蓝色的碳酸铜铜绿"
