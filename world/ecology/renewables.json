{
  "schema": "ecology/renewables@1",
  "note": "RG-A 可再生存量规律的材料属性与采集方式表（模块 server-plugin/renewable.mjs，尚未接入 sites/forest-water，接入是 RG-B）。每个字段要么有依据，要么是 null 并列入 pending；pending 的字段不得被任何代码补默认值（模块遇到 null 直接报错）。basis 取值：rule＝本仓库已发布的规则值（注明文件）；table＝本仓库已有的参数表项（用 id 引用，不复制数值）；botany＝植物学常识，常识性来源、未逐条核对文献，一律 calibration:pending 待标定；pending＝无依据，不填值。",
  "seasons": {
    "note": "季节下标与 sites.mjs seasonalSpans 一致：一年 360 日，每季 90 日，0 春 1 夏 2 秋 3 冬。",
    "daysPerSeason": 90
  },
  "methods": {
    "pull_whole": {
      "kills": "root", "takesSeed": false, "leaveCap": 0.3333333333333333,
      "basis": "botany", "calibration": "pending",
      "source": "连根拔起：整株连根带走。leaveCap 取采药/采集行业通行的“采集不超过一丛的三分之一”经验规则，常识性来源，未逐条核对文献。"
    },
    "cut_shoots": {
      "kills": "shoot", "takesSeed": false, "leaveCap": 0.3333333333333333,
      "basis": "botany", "calibration": "pending",
      "source": "割取地上茎叶：能从根重新萌发的种类不死，只靠种子更新的种类被割则当年不留种。leaveCap 同三分之一规则（常识性来源）。"
    },
    "pick_leaf": {
      "kills": "none", "takesSeed": false, "leaveCap": 0.3333333333333333,
      "basis": "botany", "calibration": "pending",
      "source": "摘叶：植株与根都留着。leaveCap 同三分之一规则（常识性来源）。"
    },
    "pick_fruit": {
      "kills": "none", "takesSeed": true, "leaveCap": 0.3333333333333333,
      "basis": "botany", "calibration": "pending",
      "source": "采果：植株留着，但果实里就是种子，结种前全采则无后代。leaveCap 同三分之一规则（常识性来源）。"
    },
    "fell_tree": {
      "kills": "shoot", "takesSeed": false, "leaveCap": 0.3333333333333333,
      "basis": "botany", "calibration": "pending",
      "source": "伐木：留桩；阔叶树多能从桩与根萌蘖，针叶树不能（species 里的 regrowFrom 决定）。leaveCap 取林业“择伐留母树”的三分之一经验量级（常识性来源）。"
    },
    "draw_water": {
      "kills": "none", "takesSeed": false, "leaveCap": 0,
      "basis": "botany", "calibration": "pending",
      "source": "取水不伤水源的繁殖基础；水的补给率与容量见 species 里 water 条目（pending）。"
    }
  },
