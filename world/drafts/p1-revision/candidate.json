{
  "revision": "p1-revision-1",
  "entries": [
    {
      "id": "item_parchment-basePrice",
      "target": "item_parchment",
      "file": "world/meta/items.json",
      "path": [
        "basePrice"
      ],
      "field": "basePrice",
      "before": 12,
      "after": 4,
      "basis": [
        "docs/审查/2026-11-05-已审内容改动盘点.md §三：item_parchment.basePrice 12 是手定价，链成本找不到通用规律命中，需走审批。",
        "产链 recipe_kc_parchment_rawhide_parchment：一份刮净生皮（8 文，一公斤）加水刮出 5 张，每张材料价 2 文；再加两小时刮制工与刮皮刀磨损，定 4 文。",
        "12 文时 29 条抄书配方（recipe_kc_copy_*）的羊皮纸材料价高于书价，违背\"配方售价不低于材料\"的世界校验。"
      ],
      "facts": {
        "parchment": {
          "id": "item_parchment",
          "name": "刮薄羊皮纸",
          "basePrice": 12,
          "use": "一张处理好的羊皮纸，可书写或裁作书签；并非食用或包药材料"
        },
        "rawhide": {
          "id": "item_rawhide",
          "name": "刮净生皮",
          "basePrice": 8,
          "use": "一公斤生皮仅刮净残肉与脂肪，毛尚在，未浸灰或鞣制；仍会腐败，撒盐不等于完成鞣制。"
        },
        "water": {
          "id": "item_water",
          "basePrice": 1
        },
        "recipe": {
          "id": "recipe_kc_parchment_rawhide_parchment",
          "materials": [
            {
              "item": "item_rawhide",
              "amount": 1
            },
            {
              "item": "item_water",
              "amount": 2
            }
          ],
          "tools": [
            "item_hide_scraper"
          ],
          "output": {
            "item": "item_parchment",
            "quantity": 5
          },
          "minutes": 120
        },
        "materialCostPerSheet": 2
      },
      "supersedes": [
        {
          "receipt": "world/drafts/w3/trades/bones.json#item_parchment",
          "field": "basePrice"
        },
        {
          "receipt": "world/drafts/w3/trades/items/item_parchment.json",
          "field": "(说明文字，不变)"
        }
      ],
      "boundary": "只改这一个已审字段；同一行的其余字段、说明文字与其它地点或配方一律不动。改动依据是本条引用的现有世界事实，不新增物品、配方或地点。"
    },
    {
      "id": "recipe_smelt_iron-tools",
      "target": "recipe_smelt_iron",
      "file": "world/meta/recipes.json",
      "path": [
        "tools"
      ],
      "field": "tools",
      "before": [
        "item_smith_hammer",
        "item_smith_tongs"
      ],
      "after": [],
      "basis": [
        "docs/审查/2026-11-05-已审内容改动盘点.md §三：冶炼要锻锤与铁钳，而锻锤、铁钳都由铁料锻成，铁料又只来自冶炼，铁链没有起点。",
        "冶炼是选矿后以木炭还原；材料和产出不变，只去掉工具要求，使第一把锤可由冶炼出的铁料锻成。",
        "工艺说明里\"锻打成可回炉铁料\"一句是已审原文，本条不改；去掉的只是锻工手锤、长柄铁钳这两件本身要用铁料锻成的工具，冶炼时的捶实不以它们为前提。"
      ],
      "facts": {
        "smelt": {
          "id": "recipe_smelt_iron",
          "materials": [
            {
              "item": "item_iron_ore",
              "amount": 2
            },
            {
              "item": "item_charcoal",
              "amount": 1
            }
          ],
          "tools": [
            "item_smith_hammer",
            "item_smith_tongs"
          ],
          "output": {
            "item": "item_iron",
            "quantity": 1
          },
          "minutes": 120,
          "process": "分选含铁矿石，以木炭还原并锻打成可回炉铁料；消耗真实矿石和燃料，失败不凭空返料。"
        },
        "hammer": {
          "id": "recipe_kc_tool_smith_hammer",
          "materials": [
            {
              "item": "item_iron",
              "amount": 1
            },
            {
              "item": "item_wood",
              "amount": 1
            }
          ],
          "tools": [],
          "output": {
            "item": "item_smith_hammer",
            "quantity": 1
          },
          "minutes": 125
        },
        "tongs": {
          "id": "recipe_kc_tool_smith_tongs",
          "materials": [
            {
              "item": "item_iron",
              "amount": 1
            }
          ],
          "tools": [
            "item_smith_hammer"
          ],
          "output": {
            "item": "item_smith_tongs",
            "quantity": 1
          },
          "minutes": 80
        },
        "ironMadeBy": [
          "recipe_smelt_iron"
        ]
      },
      "supersedes": [
        {
          "receipt": "commit 1fb65474 (S3-E04 smelting) / recipes.json#recipe_smelt_iron",
          "field": "tools"
        }
      ],
      "boundary": "只改这一个已审字段；同一行的其余字段、说明文字与其它地点或配方一律不动。改动依据是本条引用的现有世界事实，不新增物品、配方或地点。"
    },
    {
      "id": "loc_wild_lq_adit-adit_ore-item",
      "target": "loc_wild_lq_adit",
      "file": "world/geo/locations.json",
      "path": [
        "site",
        "resources",
        {
          "id": "adit_ore"
        },
        "item"
      ],
      "field": "site.resources[id=adit_ore].item",
      "before": "item_iron_scrap",
      "after": "item_iron_ore",
      "basis": [
        "docs/审查/2026-11-05-已审内容改动盘点.md §三：loc_wild_lq_adit 的资源\"坑底散落的铁砂块\"登记成铁边料小块（锻造下料的制成品），旧矿道里不会自然有锻件边料。",
        "铁砂是矿道里的含铁矿石，改登记为 item_iron_ore；资源名、数量、工时、机关不变。"
      ],
      "facts": {
        "site": {
          "location": "loc_wild_lq_adit",
          "locationName": "砾泉旧矿道口",
          "resource": {
            "id": "adit_ore",
            "name": "坑底散落的铁砂块",
            "item": "item_iron_scrap",
            "quantity": 5
          }
        },
        "ironOre": {
          "item": {
            "id": "item_iron_ore",
            "name": "含铁矿石",
            "basePrice": 4,
            "use": "含铁石块，供选矿与交易；未经冶炼不能作铁料。"
          },
          "natural": true
        },
        "ironScrap": {
          "item": {
            "id": "item_iron_scrap",
            "name": "铁边料小块",
            "basePrice": 2,
            "use": "二百克边料来自下料和锻造；须验锈裂后回炉，不能冒称完整新坯。"
          },
          "madeBy": [
            "recipe_forge_hinge",
            "recipe_kc_cut_iron_iron_scrap"
          ]
        }
      },
      "supersedes": [
        {
          "receipt": "world/design/w5-sites-1.mjs#loc_wild_lq_adit",
          "field": "site.resources[id=adit_ore].item"
        }
      ],
      "boundary": "只改这一个已审字段；同一行的其余字段、说明文字与其它地点或配方一律不动。改动依据是本条引用的现有世界事实，不新增物品、配方或地点。"
