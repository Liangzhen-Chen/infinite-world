{
  "notes": [
    {
      "id": "rumor_w5_3_33",
      "note": "石标约定和绕开低洼能对上封坑水脉，调查有双线索。"
    },
    {
      "id": "rumor_w5_3_37",
      "note": "锯口加赔偿契支持洪水前人为损坏，未指认未登记嫌犯。"
    },
    {
      "id": "rumor_w5_3_39",
      "note": "点验未收讫不推出无主，旧公物保证仍保留。"
    },
    {
      "id": "rumor_w5_3_20",
      "note": "温泉与雨水区分有渗水口证据，错误采凿判断标假。"
    },
    {
      "id": "rumor_w5_3_05",
      "note": "水位刻口埋泥说明淤高，不把水猴当建梁者。"
    },
    {
      "id": "rumor_w5_3_03",
      "note": "名录末页与翻坟位置相连，线索不代替正式度亡操作。"
    },
    {
      "id": "rumor_w5_3_06",
      "note": "鱼梁属渔户、后有水猴的顺序可核，假说把先后颠倒。"
    },
    {
      "id": "rumor_w5_3_11",
      "note": "灰层铜色和铜匠签相互印证，可调查而不许诺矿产。"
    },
    {
      "id": "rumor_w5_3_15",
      "note": "断夹朝南和石牌尾结构成旧界证据，方向没有说反。"
    },
    {
      "id": "rumor_w5_3_31",
      "note": "凿痕和自沉记两证相合，保留施家旧事的生活动机。"
    },
    {
      "id": "rumor_w5_3_40",
      "note": "撤兵不等于郡账除名，假说没有开放取物权。"
    },
    {
      "id": "rumor_w5_3_10",
      "note": "村民摆石圈为真，林界内外归属推反，核心假判断可核。"
    },
    {
      "id": "rumor_w5_3_44",
      "note": "积水细节逐字对应登记线索，独特但口语较弱，声音记三。"
    }
  ],
