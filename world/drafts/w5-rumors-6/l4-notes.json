{
  "notes": [
    {
      "id": "rumor_w5_6_10",
      "note": "冰橇朝向与刮记证改路，始终只去裂谷的说法为假。"
    },
    {
      "id": "rumor_w5_6_33",
      "note": "事故抄件对应先小后远规矩，不新增空间术效果。"
    },
    {
      "id": "rumor_w5_6_04",
      "note": "砂下井圈与湿土反证泉已经全干，恢复水源仍需清砂。"
    },
    {
      "id": "rumor_w5_6_28",
      "note": "人汗铁锈与旧夹实物对应，否认人下夹是假；未涉及幼崽私密内容。"
    },
    {
      "id": "rumor_w5_6_36",
      "note": "新布条属实，井桶旧色不能省略，半真归责有核查物。"
    },
    {
      "id": "rumor_w5_6_08",
      "note": "沉名石是纪念未寻回者，不是普通坠子，假说不补造死者身份。"
    },
    {
      "id": "rumor_w5_6_26",
      "note": "整齐割口和段首禁伐字支持主动断桥，全部自然烂断是假。"
    },
    {
      "id": "rumor_w5_6_11",
      "note": "东西回声差异与塌岩下冰镐对应，可玩调查点具体。"
    },
    {
      "id": "rumor_w5_6_31",
      "note": "灯芯、灯画和肉签连到失踪猎户，生活动机突出。"
    },
    {
      "id": "rumor_w5_6_20",
      "note": "鹿径和实心月圈反证单纯祭月解释，不编新神迹。"
    },
    {
      "id": "rumor_w5_6_15",
      "note": "抹泥爪痕是边界，干净岩槽为行动痕迹，进入前需顾巢主。"
    },
    {
      "id": "rumor_w5_6_19",
      "note": "满月鹿径与方向线相合，推测语气保留调查空间。"
    },
    {
      "id": "rumor_w5_6_06",
      "note": "樟叶记号为真，整伐权限被误推，林地禁伐保护保留。"
    },
    {
      "id": "rumor_w5_6_25",
      "note": "割口树脂和禁伐刻字双证，旧路废弃有明确来由。"
    },
    {
      "id": "rumor_w5_6_40",
      "note": "季界记号春夏禁、秋冬准，假说正好倒置，未改当前入林权限。"
    }
  ],
