{
  "notes": [
    {
      "id": "rumor_w5_4_40",
      "note": "现存幼苗核验是阶段安排，附条件和公库，未声称已经接管。"
    },
    {
      "id": "rumor_w5_4_10",
      "note": "少年在栏外和畜主同意均有原文，庆日没有送骑乘权。"
    },
    {
      "id": "rumor_w5_4_35",
      "note": "对读约定存在，忽略公库和概率为假推论，半真可核。"
    },
    {
      "id": "rumor_w5_4_26",
      "note": "工具归属核验存在，所需公库不足时不能自动推进。"
    },
    {
      "id": "rumor_w5_4_19",
      "note": "首雨可收集与水源确认分开；敲裂纹不检毒，未添加检测能力。"
    },
    {
      "id": "rumor_w5_4_09",
      "note": "堵饮水和替井绳均与登记权限相反，假说没有写成许可。"
    },
    {
      "id": "rumor_w5_4_05",
      "note": "扫阶动作与代签权混淆，家户本人同意仍保留。"
    },
    {
      "id": "rumor_w5_4_03",
      "note": "空篮只表达需要，假说把它说成收获权，核查到管理者。"
    },
    {
      "id": "rumor_w5_4_45",
      "note": "归并叫法见阶段表，直接否认是可查的假消息，句式较平。"
    },
    {
      "id": "rumor_w5_4_12",
      "note": "停用与工人资格均有登记，敲树试音是错误做法。"
    },
    {
      "id": "rumor_w5_4_20",
      "note": "借阴歇脚是真俗，井水份额的推论为假，现场应另获同意。"
    },
    {
      "id": "rumor_w5_4_15",
      "note": "救助不转移船权、不保适航，假消息同时颠倒两项边界。"
    },
    {
      "id": "rumor_w5_4_24",
      "note": "拓印没有改水位或授纸符效，真伪和普通材料保护清楚。"
    }
  ],
