    "patches": [
      {
        "path": "knowledge.known[1]",
        "value": {
          "fact": "我在刘燕户居处居住；家里的刘婵是我的女儿。",
          "source": "bld_wt_home_12",
          "reliability": "日常亲历"
        }
      },
      {
        "path": "knowledge.known[2]",
        "value": {
          "fact": "我做水岸菜圃种植户，日常劳动处在岸上菜圃；眼下遇到的是搬苇的人总抄近路。",
          "source": "npc_wt_liuyan",
          "reliability": "本人亲历，问题尚未解决"
        }
      },
      {
        "path": "knowledge.unknown[0]",
        "value": "杜珂空手试转弯后是否愿意改走远路。"
      },
      {
        "path": "knowledge.unknown[1]",
        "value": "刘婵何时能陪自己听搬苇人说明路线。"
      },
      {
        "path": "voice.register",
        "value": "谈菜床边界说得清楚而较真，商量绕行时少绕弯。"
      },
      {
        "path": "goals.short[0].steps[0].content",
        "value": "指明被脚步压到的苗边，请搬运者先停在床外。"
      },
      {
        "path": "goals.mid[0].steps[0].content",
        "value": "请杜珂空手试过转弯，再询问能否沿既有路搬运。"
      },
      {
        "path": "goals.long[0].steps[0].content",
        "value": "约邻工雨后复看床外的通行边，把仍堵路之处重新提出。"
      },
      {
        "path": "relationships[0].note",
        "value": "刘婵是家里的女儿；独立/嘴硬，这件事还需要彼此听完再商量。"
      },
      {
        "path": "relationships[1].note",
        "value": "徐沅是家里的配偶；随和/怕争执，这件事还需要彼此听完再商量。"
      },
      {
        "path": "relationships[2].note",
        "value": "与湛鸥有同村往来；对方在苇汀干路口做岸路巡看人，见面时还需问清当日劳作与通行安排。"
      },
      {
        "path": "memorySeeds[2]",
        "value": {
          "id": "memory_wt_depth_group_2",
          "event": "施峤、柯荔、杜珂和刘燕在汀口记事屋外谈过岸边的活。施峤要在干稳处看水，柯荔复述割苇和捆苇的分工，杜珂问菜床外木件转弯的空处，刘燕指出脚步不能压苗边。那次只是相互说明，没有允诺工时或通行范围。",
          "location": "bld_wt_hall",
          "salience": 4,
          "knownBy": [
            "npc_wt_shiqiao",
            "npc_wt_keli",
            "npc_wt_duke",
            "npc_wt_liuyan"
          ],
          "reliability": "共同亲历；未解决的分歧仍待各户核对"
        }
      },
      {
        "path": "opinions.neighbors[2].view",
        "value": "湛鸥在苇汀干路口做岸路巡看人；与他谈通行和劳作时，我会先问清当日安排。"
      }
    ]
  },
