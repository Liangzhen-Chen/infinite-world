    "patches": [
      {
        "path": "knowledge.known[1]",
        "value": {
          "fact": "洪水之后一边举行林地仪式一边实际修渠",
          "source": "npc_hw_meiling",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.known[2]",
        "value": {
          "fact": "吴朔、梅绫和安槐谈林果边界。吴朔关心少惊扰繁殖地，梅绫照护公用果园，安槐说明蜂群授粉的想法；共同试验仍须另行商量。",
          "source": "npc_hw_meiling",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.unknown[0]",
        "value": "安槐希望在果园哪段观察授粉，是否影响繁殖地边界。"
      },
      {
        "path": "knowledge.unknown[1]",
        "value": "罗苇何时方便共同核对果园与邻田的排水先后。"
      },
      {
        "path": "goals.short[0].steps[1].content",
        "value": "逐株查看现存幼树，记下仍受积水影响的位置。"
      },
      {
        "path": "goals.mid[0].steps[1].content",
        "value": "对照邻田沟段与果园低处，先问罗苇的用水安排。"
      },
      {
        "path": "goals.long[0].steps[1].content",
        "value": "把幼树照护与修渠工时分别列出，再询问愿参与的住户。"
      },
      {
        "path": "voice.register",
        "value": "果园照护口吻，谈树细致，谈损苗时直接"
      },
      {
        "path": "memorySeeds[2]",
        "value": {
          "id": "memory_t10_orchard-boundary",
          "event": "在旧渡口公用水盏周边，吴朔、梅绫和安槐谈林果边界。吴朔关心少惊扰繁殖地，梅绫照护公用果园，安槐说明蜂群授粉的想法；共同试验仍须另行商量。",
          "knownBy": [
            "npc_hw_wushuo",
            "npc_hw_meiling",
            "npc_hw_anhuai"
          ],
          "salience": 3,
          "reliability": "亲历",
          "location": "loc_hw_dock"
        }
      },
      {
        "path": "relationships[0].note",
        "value": "与安槐谈果园和蜂场的授粉往来，先核对观察范围再商量试验。"
      },
      {
        "path": "relationships[1].note",
        "value": "与罗苇谈邻田和果园用水，排水先后需对照沟段再商议。"
      },
      {
        "path": "relationships[2].note",
        "value": "与贺舟谈公共雕刻，欣赏尊重土地与人物同意的作品，先问清用途。"
      }
