    "id": "npc_hw_feikai",
    "contract": "audit-patch-v1",
    "patches": [
      {
        "path": "knowledge.known[1]",
        "value": {
          "fact": "杭梨见他淋湿还要上高处，先叫他换下湿衣再动身。",
          "source": "npc_hw_feikai",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.known[2]",
        "value": {
          "fact": "费铠做屋檐登高工作前向顾岑说清外侧檐下的危险，提醒底下这段先避开行人。",
          "source": "npc_hw_feikai",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.unknown[0]",
        "value": "杭梨何时方便让自己换下的湿衣晾干。"
      },
      {
        "path": "knowledge.unknown[1]",
        "value": "顾岑哪次方便核对檐下行人动线，屋主是否允许查看外檐。"
      },
      {
        "path": "goals.short[0].steps[1].content",
        "value": "在雨后按檐下水痕逐处看，分清溅水和漏水再记位置。"
      },
      {
        "path": "goals.mid[0].steps[1].content",
        "value": "先问屋主是否允许登高，再确认檐下避人和本人能用的时段。"
      },
      {
        "path": "goals.long[0].steps[1].content",
        "value": "比较要登高的工序与可在地面做的准备，重件另问帮工意愿。"
      },
      {
        "path": "voice.register",
        "value": "修缮询价口吻，按水痕和支点说明，报价前先查看"
      },
      {
        "path": "memorySeeds[2]",
        "value": {
          "id": "memory_t10_eaves-warning",
          "event": "在旧渡口公用水盏周边，费铠做屋檐登高工作前向顾岑说清外侧檐下的危险，提醒底下这段先避开行人。",
          "knownBy": [
            "npc_hw_feikai",
