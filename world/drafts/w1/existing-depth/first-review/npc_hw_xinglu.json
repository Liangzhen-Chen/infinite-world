  "attempts": 3,
  "draft": {
    "id": "npc_hw_xinglu",
    "contract": "audit-patch-v1",
    "patches": [
      {
        "path": "knowledge.known[1]",
        "value": {
          "fact": "华慈有回走泥路险些滑倒，从那以后他给她挑较干的路走，雨天更盯着她脚下。",
          "source": "npc_hw_xinglu",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.known[2]",
        "value": {
          "fact": "罗苇、邢芦和谢堇谈田边用水。邢芦与罗苇看过南田沟口淤塞，谢堇向罗苇询问用水先后；各户的清沟分工和用水次序仍须商议。",
          "source": "npc_hw_xinglu",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.unknown[0]",
        "value": "罗苇愿先清南田哪段沟，两家分工能否说清。"
      },
      {
        "path": "knowledge.unknown[1]",
        "value": "谢堇希望哪一轮用水先排，是否会使自家段再积水。"
      },
      {
        "path": "goals.short[0].steps[1].content",
        "value": "对照田埂与沟口位置，把自家这次积水处单独记下。"
      },
      {
        "path": "goals.mid[0].steps[1].content",
        "value": "把可做的工时和自家沟段列给罗苇，先问相邻农户的安排。"
      },
      {
        "path": "goals.long[0].steps[1].content",
        "value": "先查看雨后较干的路段，再向华慈说明可以避开的泥处。"
      },
      {
        "path": "voice.register",
        "value": "佃农轮工口吻，指明沟段，逐句算可承担的工时"
      },
      {
        "path": "memorySeeds[2]",
        "value": {
          "id": "memory_t10_south-water",
          "event": "在旧渡口公用水盏周边，罗苇、邢芦和谢堇谈田边用水。邢芦与罗苇看过南田沟口淤塞，谢堇向罗苇询问用水先后；各户的清沟分工和用水次序仍须商议。",
          "knownBy": [
            "npc_hw_luowei",
            "npc_hw_xinglu",
            "npc_hw_xiejin"
          ],
          "salience": 3,
          "reliability": "亲历",
          "location": "loc_hw_dock"
        }
      },
      {
        "path": "relationships[0].note",
        "value": "华慈走泥路险滑后，邢芦为母亲挑较干的路，雨天留意脚下。"
      },
      {
        "path": "relationships[2].note",
        "value": "与罗苇一起看过南田沟口淤塞，谁先清哪段仍要分开商议。"
      }
    ]
