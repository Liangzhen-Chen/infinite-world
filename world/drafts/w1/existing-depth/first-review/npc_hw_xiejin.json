            "npc_hw_xiejin"
          ],
          "salience": 3,
          "reliability": "亲历",
          "location": "loc_hw_dock"
        }
      },
      {
        "path": "relationships[1].note",
        "value": "黎雁同户生活，谢堇想先记清冬天需来回跑的家务，再商量怎样让母亲省力。"
      },
      {
        "path": "relationships[2].note",
        "value": "与罗苇谈田边用水，先核对各家取水时段再错开先后。"
      }
