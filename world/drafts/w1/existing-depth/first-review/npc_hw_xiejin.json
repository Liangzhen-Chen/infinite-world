    "id": "npc_hw_xiejin",
    "contract": "audit-patch-v1",
    "patches": [
      {
        "path": "knowledge.known[1]",
        "value": {
          "fact": "谢芮第一次独自安排完家务，她看了一遍，手抬起来又放下，终究没有重新改。",
          "source": "npc_hw_xiejin",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.known[2]",
        "value": {
          "fact": "罗苇、邢芦和谢堇谈田边用水。邢芦与罗苇看过南田沟口淤塞，谢堇向罗苇询问用水先后；各户的清沟分工和用水次序仍须商议。",
          "source": "npc_hw_xiejin",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.unknown[0]",
        "value": "罗苇何时准备取水，哪一轮希望与自家错开。"
      },
      {
        "path": "knowledge.unknown[1]",
        "value": "谢芮哪段家务已能独立记清，是否会撞上学堂课时。"
      },
      {
        "path": "goals.short[0].steps[1].content",
        "value": "先看河边水色，再向罗苇核对各家拟用水的时段。"
      },
      {
        "path": "goals.mid[0].steps[1].content",
        "value": "请谢芮自己列家务次序，再一起核对上学时间。"
      },
      {
        "path": "goals.long[0].steps[1].content",
        "value": "向黎雁问清冬天哪件事最费来回，把能在本户做的轻活先分开。"
      },
      {
        "path": "voice.register",
        "value": "河岸农户的日常口吻，以水色和天色说明，谈孩子先商量"
      },
      {
        "path": "memorySeeds[2]",
        "value": {
          "id": "memory_t10_south-water",
          "event": "在旧渡口公用水盏周边，罗苇、邢芦和谢堇谈田边用水。邢芦与罗苇看过南田沟口淤塞，谢堇向罗苇询问用水先后；各户的清沟分工和用水次序仍须商议。",
          "knownBy": [
            "npc_hw_luowei",
