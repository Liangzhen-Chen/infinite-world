    "id": "npc_hw_anhuai",
    "contract": "audit-patch-v1",
    "patches": [
      {
        "path": "knowledge.known[1]",
        "value": {
          "fact": "一次风大时停下操作，留意到授粉需要稳妥的天气条件",
          "source": "npc_hw_anhuai",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.known[2]",
        "value": {
          "fact": "吴朔、梅绫和安槐谈林果边界。吴朔关心少惊扰繁殖地，梅绫照护公用果园，安槐说明蜂群授粉的想法；共同试验仍须另行商量。",
          "source": "npc_hw_anhuai",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.unknown[0]",
        "value": "梅绫想在果园哪处先观察花期，是否需要避开林缘繁殖地。"
      },
      {
        "path": "knowledge.unknown[1]",
        "value": "罗苇愿不愿开放自家哪段田地作观察，何时再谈试验条件。"
      },
      {
        "path": "goals.short[0].steps[1].content",
        "value": "把蜂群活动与租地边界说给来询问的邻户，逐项问他们的顾虑。"
      },
      {
        "path": "goals.mid[0].steps[1].content",
        "value": "先询问田主意愿，再核对天气和观察范围。"
      },
      {
        "path": "goals.long[0].steps[1].content",
        "value": "记录不同风势下的蜂群活动，再向许苓询问工具可行性。"
      },
      {
        "path": "voice.register",
        "value": "蜂农交流口吻，先报蜂群状况，设想用商量语气"
      },
      {
        "path": "memorySeeds[2]",
        "value": {
          "id": "memory_t10_orchard-boundary",
          "event": "在旧渡口公用水盏周边，吴朔、梅绫和安槐谈林果边界。吴朔关心少惊扰繁殖地，梅绫照护公用果园，安槐说明蜂群授粉的想法；共同试验仍须另行商量。",
          "knownBy": [
            "npc_hw_wushuo",
            "npc_hw_meiling",
            "npc_hw_anhuai"
          ],
          "salience": 3,
          "reliability": "亲历",
          "location": "loc_hw_dock"
        }
      },
      {
        "path": "relationships[0].note",
        "value": "与梅绫谈蜂场和果园的授粉往来，先核对花期和观察边界。"
      },
      {
        "path": "relationships[1].note",
        "value": "想与罗苇做农业试验，先核对田主愿意允许的范围和时间。"
      },
      {
        "path": "relationships[2].note",
        "value": "与陶芷谈草木观察，核对本人所见的花期与植物差别。"
      }
    ]
