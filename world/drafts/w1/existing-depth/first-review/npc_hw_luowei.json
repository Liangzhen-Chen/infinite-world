    "id": "npc_hw_luowei",
    "contract": "audit-patch-v1",
    "patches": [
      {
        "path": "knowledge.known[1]",
        "value": {
          "fact": "翻过一袋受潮的种子，记住了霉味和健康种子的区别",
          "source": "npc_hw_luowei",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.known[2]",
        "value": {
          "fact": "罗苇、邢芦和谢堇谈田边用水。邢芦与罗苇看过南田沟口淤塞，谢堇向罗苇询问用水先后；各户的清沟分工和用水次序仍须商议。",
          "source": "npc_hw_luowei",
          "reliability": "亲历"
        }
      },
      {
        "path": "knowledge.unknown[0]",
        "value": "邢芦愿先清哪一段南田沟，何时能空出工日。"
      },
      {
        "path": "knowledge.unknown[1]",
        "value": "谢堇想把哪次用水排在前面，是否与自家田段冲突。"
      },
      {
        "path": "goals.short[0].steps[1].content",
        "value": "逐袋查看种子干湿和霉味，把可疑种粒单独放好。"
      },
      {
        "path": "goals.mid[0].steps[1].content",
        "value": "与邢芦对照淤塞位置，记明自家段和相邻段的分界。"
      },
      {
        "path": "goals.long[0].steps[1].content",
        "value": "同施锦核对留种与食粮的分袋情况，再安排雨前收晒。"
      },
      {
        "path": "voice.register",
        "value": "田间算工口吻，以土湿、种子和工日说明打算"
      },
      {
        "path": "memorySeeds[2]",
        "value": {
          "id": "memory_t10_south-water",
          "event": "在旧渡口公用水盏周边，罗苇、邢芦和谢堇谈田边用水。邢芦与罗苇看过南田沟口淤塞，谢堇向罗苇询问用水先后；各户的清沟分工和用水次序仍须商议。",
          "knownBy": [
            "npc_hw_luowei",
            "npc_hw_xinglu",
            "npc_hw_xiejin"
          ],
          "salience": 3,
          "reliability": "亲历",
          "location": "loc_hw_dock"
        }
      },
      {
        "path": "relationships[1].note",
        "value": "与梅绫核对邻田和果园沟渠的排水先后，都担心积水伤种苗。"
      },
      {
        "path": "relationships[2].note",
        "value": "对安槐的蜂群授粉设想有兴趣，试验前要先问清范围再谈土地使用。"
      }
