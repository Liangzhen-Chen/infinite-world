{
  "notes": [
    {
      "id": "rumor_w5_5_20",
      "note": "半道短痕与留矿者对应，全部撤出的说法是假，不新增失踪人物姓名。"
    },
    {
      "id": "rumor_w5_5_37",
      "note": "沙划痕与浅滩短纹能交叉核查，暗礁误传有具体物证。"
    },
    {
      "id": "rumor_w5_5_39",
      "note": "引潮沟朝向和水道南移对应三处旧事，串联地点明确。"
    },
    {
      "id": "rumor_w5_5_09",
      "note": "封墙三矿工记号连接石标，水脉关系未被简化为可任挖。"
    },
    {
      "id": "rumor_w5_5_18",
      "note": "停火是真背景，炉契所有权并未放弃，半真解释可查。"
    },
    {
      "id": "rumor_w5_5_28",
      "note": "底本保留旧位置，假说的无从查与现有线索直接相反。"
    },
    {
      "id": "rumor_w5_5_07",
      "note": "节疤配土图对应穴居者旧争议，不把两族之一说成全体同意。"
    },
    {
      "id": "rumor_w5_5_12",
      "note": "税簿空车是真字面，核心无铜无漏税为假，车辙铜屑可核。"
    },
    {
      "id": "rumor_w5_5_30",
      "note": "异土与底本证挪碑，假说没有新增税制。"
    },
    {
      "id": "rumor_w5_5_23",
      "note": "旧堡器具与石冢缺口相接，送还只讲原有了结办法。"
    },
    {
      "id": "rumor_w5_5_03",
      "note": "计趟刻道与脚窝深浅支持背盐换肩，保留现有兽巢危险。"
    },
    {
      "id": "rumor_w5_5_29",
      "note": "碑土、底本和过境钱相连，调查入口明确而不直接定罪。"
    },
    {
      "id": "rumor_w5_5_01",
      "note": "绿砂分布连接铜砾岭洗石来历，两处路线均已经登记。"
    }
  ],
