{
  "notes": [
    {
      "id": "rumor_w5_2_25",
      "note": "饮用与工艺水对账及旱年分歧来自公开字段。"
    },
    {
      "id": "rumor_w5_2_42",
      "note": "夜议绳记和派别顺序均被假说颠倒，核验未泄露私密目标。"
    },
    {
      "id": "rumor_w5_2_19",
      "note": "劳动分账连接近岸挡浪与外湾留船道，利益分歧清楚。"
    },
    {
      "id": "rumor_w5_2_45",
      "note": "禁猎季和老群母立场均有原文，否定说法可识破。"
    },
    {
      "id": "rumor_w5_2_13",
      "note": "大帐饮畜与小帐渴需都有原文，适合询问水程见证人。"
    },
    {
      "id": "rumor_w5_2_28",
      "note": "裂纹、隔离班、停炉与产量来自方法和分派，不承诺已经开班。"
    },
    {
      "id": "rumor_w5_2_32",
      "note": "好纸与符效混淆是可核的半真，未给普通纸添加效果。"
    },
    {
      "id": "rumor_w5_2_41",
      "note": "留刻痕为真，有人提议不等于通过，作者事实限定计划。"
    },
    {
      "id": "rumor_w5_2_01",
      "note": "泊位立场来自温和与垄断分派，可向船户住户交叉核对。"
    },
    {
      "id": "rumor_w5_2_24",
      "note": "有限记忆和亲闻补述的界限清楚，假说未改变记忆系统。"
    },
    {
      "id": "rumor_w5_2_30",
      "note": "复测和保留异常值恰与说法相反；短句较平，辨识度记三。"
    },
    {
      "id": "rumor_w5_2_29",
      "note": "事故楔是警示物，不能赋断梁新力；错把提醒当能力。"
    },
    {
      "id": "rumor_w5_2_06",
      "note": "联盟保公岸和低渡费，假说颠倒公共目标，没有新实体。"
    },
    {
      "id": "rumor_w5_2_37",
      "note": "巢区外围与近巢边界来自护幼和远猎分派，询问须守边界。"
    },
    {
      "id": "rumor_w5_2_21",
      "note": "分项航价和统一船费说法相反，可查现有公开分项。"
    }
  ],
