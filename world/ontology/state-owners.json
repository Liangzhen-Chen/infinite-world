{
 "version": 1,
 "stateKeys": {
  "created": {"readers": ["dim:*"], "writers": {"*.props.*": "kernel/dimension-writers.mjs", "*.props.basis": "kernel/dimension-writers.mjs"}},
  "displayNames": {"readers": [], "writers": {"*": "ai-gate/naming-gate.mjs"}, "display": ["*.text"]},
  "pendingPost": {"readers": ["kernel/scheduler.mjs"], "writers": {"*": "kernel/transaction.mjs"}},
  "playerNotes": {"readers": [], "writers": {"*": "ai-gate/note-gate.mjs"}, "display": ["*.text"]},
  "terminated": {"readers": ["view:capacity"], "writers": {"*": "kernel/terminate.mjs"}}
 },
 "systems": {
  "sys.dimension_entry": {"tables": [], "entryCallerFiles": {}, "entryJudges": []}
 },
 "textPaths": ["displayNames.*.text", "playerNotes.*.text", "narration.*"],
 "textWriters": {"displayNames.*.text": "ai-gate/naming-gate.mjs", "playerNotes.*.text": "ai-gate/note-gate.mjs", "narration.*": "ai-gate/narration-gate.mjs"},
 "pathTypes": {
  "created.*.props.*": "dimension",
  "created.*.props.basis": "struct:basis",
  "displayNames.*.seq": "integer:count",
  "displayNames.*.text": "sealed",
  "narration.*": "sealed",
  "pendingPost.*": "list<struct:pendingPost>",
  "playerNotes.*.text": "sealed",
  "terminated.*": "struct:terminated"
 },
 "keyKinds": {
  "created.*.props.*": [["item", "person", "place"], "dimKey"],
  "created.*.props.basis": [["item", "person", "place"]],
  "displayNames.*.seq": [["person", "identityKey"]],
  "pendingPost.*": ["event"],
  "terminated.*": [["item", "org", "person", "place"]]
 },
 "readShapes": [],
 "phases": ["clock", "environment", "body", "needs", "economy", "society", "events", "projection"],
 "rxNamespaces": [
  {"ns": "lot.spoilage","type": "number", "entry": "该份材料所在批次或实例的当日腐坏进度", "shape": "fraction", "volume": "卷四 §4.7.7（diet eats 的写法见 §4.7.5）"},
  {"ns": "material","type": "field", "entry": "被求值的那一份材料的维度（变量口径同卷三乙 §4.3 C-1）", "shape": "<维度键>，另有 classes（set，只作 member 的 set）", "volume": "卷四 §4.7.7（diet eats 的写法见 §4.7.5）"}
 ],
 "inputEdge": {"modules": ["server-plugin/input/**/*.mjs"], "process": "server", "outputSchema": "schema:input-edge-v1"},
 "display": {"modules": ["extension/**/*.mjs", "!extension/host/**", "!extension/textcore/**"], "process": "client"},
 "gate": {"modules": ["server-plugin/gate/**/*.mjs"], "process": "server"},
 "outputGate": {"modules": ["server-plugin/output-gate/**/*.mjs"], "process": "server"},
 "aiGate": {"modules": ["server-plugin/ai-gate/**/*.mjs"], "process": "server"},
 "host": {"modules": ["extension/host/**/*.mjs"], "process": "client"},
 "textcore": {"modules": ["server-plugin/textcore/**/*.mjs"], "process": "server"},
 "clientTextcore": {"modules": ["extension/textcore/**/*.mjs"], "process": "client"},
 "kernel": {"modules": ["server-plugin/kernel/**/*.mjs"], "process": "server", "filesList": "server-plugin/kernel/files.json"},
 "assembly": {"files": ["server-plugin/index.mjs"], "process": "server", "calls": ["createRouterCaps", "createDigestCap", "createWallTimer", "mountKernel", "registerSystems", "mountOutput", "mountAi", "mountMenuEntry", "mountSaveRoutes", "mountNarration", "mountInput"]},
 "retired": ["server-plugin/legacy/**", "server-plugin/compat/**", "server-plugin/migrations/**"],
 "kernelApi": {"exports": [
  {"export": "kernel/storage.mjs#readPath", "callers": ["rules"], "acceptsState": true},
  {"export": "kernel/storage.mjs#writePath", "callers": ["rules"], "acceptsState": true},
  {"export": "kernel/transaction.mjs#registerHoldWhileRecompute", "callers": ["rules"], "acceptsState": false},
  {"export": "kernel/clone.mjs#clone", "callers": ["rules"], "acceptsState": false},
  {"export": "kernel/handles/generated.mjs#V", "callers": ["*"], "acceptsState": false},
  {"export": "kernel/handles/generated.mjs#E", "callers": ["*"], "acceptsState": false},
  {"export": "kernel/handles/generated.mjs#P", "callers": ["rules"], "acceptsState": false},
  {"export": "kernel/handles/entity-id.mjs#entityId", "callers": ["rules"], "acceptsState": false},
  {"export": "kernel/vocab.mjs#vocab", "callers": ["*"], "acceptsState": false},
  {"export": "kernel/vocab.mjs#kindOf", "callers": ["*"], "acceptsState": false},
  {"export": "kernel/vocab.mjs#idIndex", "callers": ["textcore", "gate", "outputGate", "aiGate", "inputEdge"], "acceptsState": false},
  {"export": "kernel/transaction.mjs#submitProposal", "callers": ["inputEdge"], "acceptsState": false},
  {"export": "kernel/storage.mjs#readSealed", "callers": ["outputGate"], "acceptsState": true},
  {"export": "kernel/storage.mjs#writeSealed", "callers": ["aiGate"], "acceptsState": true},
  {"export": "kernel/report.mjs#report", "callers": ["*"], "acceptsState": false},
  {"export": "kernel/errors.mjs#reportError", "callers": ["*"], "acceptsState": false}
 ]},
 "groupApi": {"exports": [
  {"export": "systems.mjs#registerSystems", "callerFiles": ["index.mjs"]}
 ]},
 "importMatrix": {
  "codeExtensions": [".mjs", ".js", ".cjs", ".ts", ".mts", ".cts"],
  "processes": {
   "server": {"root": "server-plugin/", "remainderGroup": "rules"},
   "client": {"root": "extension/"}
  },
  "offline": {"modules": ["tools/**", "tests/**"]},
  "defaultCode": "E-VIEW-INPUT-IMPORT",
  "procCode": "E-PROC-IMPORT",
  "globalCode": "E-GLOBAL-UNLISTED",
  "dataCode": "E-TSC-PARSE",
  "unassignedCode": "E-FILE-UNASSIGNED",
  "dataLoaders": [],
  "cols": {"textcore": {"code": "E-TEXTCORE-IMPORT"}},
  "rows": {
   "kernel": {"code": "E-KERNEL-UPWARD-IMPORT", "groups": ["kernel"],
    "builtins": {
     "node:fs": ["server-plugin/kernel/load/*", "server-plugin/kernel/save.mjs", "server-plugin/kernel/report.mjs"],
     "node:path": ["server-plugin/kernel/load/*", "server-plugin/kernel/save.mjs", "server-plugin/kernel/report.mjs"],
     "node:url": ["server-plugin/kernel/load/*", "server-plugin/kernel/save.mjs", "server-plugin/kernel/report.mjs"]
    },
    "packages": {"ajv": ["server-plugin/kernel/validate/narrow.mjs"]}},
   "rules": {"groups": ["kernel", "rules"]},
   "textcore": {"groups": ["kernel", "textcore"],
    "builtins": {
     "node:fs": ["server-plugin/textcore/labels.mjs"],
     "node:path": ["server-plugin/textcore/labels.mjs"],
     "node:crypto": ["server-plugin/textcore/digest.mjs"]
    }},
   "inputEdge": {"groups": ["kernel", "rules", "textcore", "inputEdge", "aiGate"]},
   "gate": {"groups": ["kernel", "textcore", "gate"],
    "builtins": {"node:fs": ["server-plugin/gate/load-blocklist.mjs"], "node:path": ["server-plugin/gate/load-blocklist.mjs"]}},
   "outputGate": {"groups": ["kernel", "rules", "textcore", "gate", "outputGate"],
    "builtins": {"node:fs": ["server-plugin/output-gate/display-load.mjs"]}},
   "aiGate": {"groups": ["kernel", "rules", "textcore", "gate", "aiGate"],
    "builtins": {"node:fs": ["server-plugin/ai-gate/recorder.mjs"]}},
   "assembly": {"groups": ["kernel", "rules", "textcore", "inputEdge", "outputGate", "aiGate"]},
   "host": {"groups": ["host", "display", "clientTextcore"],
    "external": {"../../../extensions.js": ["extension/host/bootstrap.mjs"]}},
   "display": {"groups": ["display", "clientTextcore"]},
   "clientTextcore": {"groups": ["clientTextcore"]}
  }
 }
}
