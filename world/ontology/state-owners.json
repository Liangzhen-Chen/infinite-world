  "ledgerCounters": {"readers": [], "writers": {"lotNext": "kernel/ledger.mjs"}},
  "ledgerTotals": {"readers": [], "writers": {"": "kernel/ledger.mjs"}},
  "outflowTotals": {"readers": [], "writers": {"*": "kernel/ledger.mjs"}},
  "stockLots": {"readers": [], "writers": {"*": "kernel/ledger.mjs"}},
