 "rxNamespaces": [
  {"ns": "env.seasonCurve","type": "number", "entry": "求值主体所在天气单元所引气候原型（单元 climateProto，rules.climateProto）的该天气行季节曲线在当日半球归一太阳相位处的值（weather.weightRX 的变量域之一）；单元未引原型或原型没有该行曲线即缺读数", "shape": "<天气行>", "volume": "卷二十 §4.3.3 第 3 条 :631（weightRX 变量域含静态维度与太阳相位，例『precipSeasonality 在当前相位的份额』：曲线在当前相位的取值以数值交入）、§2.5 :278（weightRX 变量域：天气单元行的静态维度与 env.solarPhase；单元的 climateProto 是静态维度）；李白 11-19 15:5x ⑤（季节曲线挂气候原型）"},
  {"ns": "env.solarPhase","type": "number", "entry": "求值主体所在地点当日的半球归一太阳相位（weather.weightRX 的变量域之一）", "shape": "fraction", "volume": "卷二十 §2.5 :276（weightRX 变量域）、§2.7 env.solarPhase、§4.4.3 第 2 条"},
  {"ns": "item","type": "field", "entry": "被求值的那一件物品模板行的维度与手写组件类（类别规则 rules.items.categoryRules、classRules 的 when 读它；变量口径卷三乙 §4.3 C-1、C-8；块 6 第 6-2 张）", "shape": "<维度键>，另有 classes（set，只作 member 的 set）", "volume": "卷三乙 §4.3.3 C-1、C-8"},
  {"ns": "lot.spoilage","type": "number", "entry": "该份材料所在批次或实例的当日腐坏进度", "shape": "fraction", "volume": "卷四 §4.7.7（diet eats 的写法见 §4.7.5）"},
  {"ns": "material","type": "field", "entry": "被求值的那一份材料的维度（变量口径同卷三乙 §4.3 C-1）；类别规则 rules.items.categoryRules、classRules 的 when 里被求值的是一件物品模板，读它按 M-1 与 rules.items.aggregation 聚合的材料量（同 materialView 给物品模板 id，静态读法 T-14；只收口径不为 none 的维度；卷三乙 §3.1 :425、§4.3.3 C-1 ②）", "shape": "<维度键>，另有 classes（set，只作 member 的 set）", "volume": "卷四 §4.7.7（diet eats 的写法见 §4.7.5）"}
 ],
