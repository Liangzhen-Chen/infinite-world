{
 "$schema": "../../schemas/dimensions.schema.json",
 "behaviors": [
  "attach",
  "attest",
  "contain",
  "insulate",
  "protect",
  "provide_ability",
  "read",
  "remains",
  "wear"
 ],
 "classes": {},
 "dimensions": {
  "abilities": {"type": "map", "key": {"type": "ref", "vocab": "ability"}, "value": {"type": "integer", "unit": "count", "domain": [1, 3]}, "required": "byClass:comp_tool", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2 :179；CDDA qualities", "owner": "卷三乙 §4.6"},
  "accepts": {"type": "set", "of": {"type": "ref", "refs": [{"vocab": "class"}, {"vocab": "substance"}, {"vocab": "matcat"}, {"vocab": "matter"}]}, "domain": {"maxSize": 8}, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷三乙 §2.2；DF#36", "owner": "卷三乙 §4.4"},
  "acceptsMaterial": {"type": "map", "key": {"type": "ref", "vocab": "matgroup"}, "value": {"type": "rx"}, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷三乙 §2.2；RW stuffCategories", "owner": "卷三乙 §4.2"},
  "attachModifiers": {"type": "list", "domain": {}, "of": {"type": "struct", "required": ["id", "priority", "scope", "stage", "target", "unpenalized"], "fields": {"id": {"type": "string"}, "target": {"type": "string"}, "scope": {"type": "enum", "vocab": "scope"}, "stage": {"type": "enum", "vocab": "stage"}, "value": {"type": "number", "unit": "dimensionless", "precision": 4, "nullable": true}, "valueRX": {"type": "rx", "nullable": true}, "when": {"type": "rx", "nullable": true}, "priority": {"type": "integer", "unit": "count"}, "unpenalized": {"type": "boolean"}}}, "required": "byClass:comp_attachment", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA#66；元素是卷二 §1.5 struct:modifier 的字段（本卡取去掉 source、stackGroup、duration、basis 的子集，其余随修正项来源接入补）", "owner": "卷三乙 §4.14"},
  "areaM2": {"type": "number", "unit": "m2", "domain": [0, 1000], "precision": 4, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；卷目子系统 17", "owner": "卷三乙 §4.17"},
  "armorFactor": {"type": "number", "unit": "dimensionless", "domain": [0, 4], "precision": 4, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；RW 03 §10.2", "owner": "卷三乙 §4.13"},
  "arcSchool": {"type": "ref", "vocab": "arcschool", "nullable": true, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷十五 §2.3 登记", "owner": "卷十五 §2.3"},
  "attacks": {"type": "list", "domain": {}, "of": {"type": "struct", "required": ["contactArea", "edge", "penetration", "speedMult"], "fields": {"edge": {"type": "boolean"}, "contactArea": {"type": "number", "unit": "cm2", "domain": [0, null], "precision": 4}, "penetration": {"type": "number", "unit": "cm", "domain": [0, null], "precision": 4}, "speedMult": {"type": "number", "unit": "dimensionless", "domain": [0, null], "precision": 4}}}, "required": "byClass:comp_weapon", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；DF 01 §2.2", "owner": "卷三乙 §4.13（结算归卷十三 §4.1）"},
  "beautyForm": {"type": "number", "unit": "dimensionless", "domain": [0, null], "precision": 4, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二十三 §2.2 登记；RW 03 §10.5", "owner": "卷二十三 §2.2"},
  "bulkForm": {"type": "ref", "vocab": "bulkform", "required": "never", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；李白 11-13 裁定（第五版：形态归物品不归材料）；必填按可能物态集含固判，加载校验 I-8", "owner": "卷三乙 §4.2"},
  "breathability": {"type": "number", "unit": "fraction", "domain": [0, 1], "precision": 4, "derived": "卷三乙 §4.13：穿戴物透气，派生", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；CDDA；RW", "owner": "卷三乙 §4.13"},
  "cargoVolumeL": {"type": "number", "unit": "L", "domain": [0, null], "precision": 4, "derived": "卷十七 §2.3 登记：货舱容积", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷十七 §2.3 登记", "owner": "卷十七 §2.3"},
  "categoryKind": {"type": "enum", "vocab": "category", "derived": "first(rules.items.categoryRules)", "required": "never", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2、C-1", "owner": "卷三乙 §4.3"},
  "coverage": {"type": "number", "unit": "fraction", "domain": [0, 1], "precision": 4, "required": "byClass:comp_wearable", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；DF coverage", "owner": "卷三乙 §4.13"},
  "covers": {"type": "set", "of": {"type": "ref", "vocab": "body_part"}, "domain": {"maxSize": 16}, "required": "byClass:comp_wearable", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA covers", "owner": "卷三乙 §4.13"},
  "dailyUse": {"type": "number", "unit": "kg_per_day", "domain": [0, 50], "precision": 4, "required": "ifPresent:usageClass", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；九维之二", "owner": "卷三乙 §4.3"},
  "dailyUses": {"type": "number", "unit": "per_day", "domain": [0, 200], "precision": 4, "required": "byClass:comp_durable", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；卷二 §5.1 lifeDays 式", "owner": "卷三乙 §4.10"},
  "density": {"type": "number", "unit": "kg_per_L", "domain": [0, null], "precision": 4, "derived": "hmean(material 各份的静态物态密度)", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2、I-1", "owner": "卷三乙 §4.2"},
  "difficulty": {"type": "number", "unit": "score", "domain": [0, 100], "precision": 4, "required": "byClass:comp_readable", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；CDDA book", "owner": "卷三乙 §4.15"},
  "docKind": {"type": "ref", "vocab": "dockind", "required": "byClass:comp_document", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；09 §1.13", "owner": "卷三乙 §4.15"},
  "dragPerM": {"type": "number", "unit": "per_m", "domain": [0, 1], "precision": 4, "required": "byClass:comp_missile", "onUnknown": "error", "modifiable": false, "source": "卷十三 §2.3 登记", "owner": "卷十三 §2.3"},
  "emits": {"type": "list", "domain": {"maxSize": 4}, "of": {"type": "struct", "required": ["field", "ratePerStep"], "fields": {"field": {"type": "ref", "vocab": "field"}, "ratePerStep": {"type": "number", "unit": "score", "precision": 4}, "chance": {"type": "number", "unit": "fraction", "precision": 4, "nullable": true}}}, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷三乙 §2.2；CDDA#46；卷二十 §8 问题 11（struct:emission，卷二十 §2.8）", "owner": "卷三乙 §4.11；结构归卷二十 §2.8"},
  "edgeRatio": {"type": "number", "unit": "fraction", "domain": [0, 1], "precision": 4, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；DF 01 §2.2 刃口", "owner": "卷三乙 §4.8、§4.13"},
  "encumbrance": {"type": "number", "unit": "score", "domain": [0, null], "precision": 4, "derived": "卷三乙 §4.13：穿戴物累赘，派生", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2", "owner": "卷三乙 §4.13"},
  "faultChanceMult": {"type": "number", "unit": "dimensionless", "domain": [0, 10], "precision": 4, "required": "ifPresent:faultSet", "onUnknown": "error", "modifiable": true, "stacking": "none", "bounds": [0, 10], "source": "卷三乙 §2.2；CDDA#25", "owner": "卷三乙 §4.9"},
  "faultSet": {"type": "set", "of": {"type": "ref", "vocab": "fault"}, "domain": {"maxSize": 8}, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷三乙 §2.2；CDDA#25", "owner": "卷三乙 §4.9"},
  "fitBody": {"type": "ref", "kind": "body_plan", "required": "byClass:comp_wearable", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；DF 按种族尺码", "owner": "卷三乙 §4.13"},
  "fitSize": {"type": "enum", "vocab": "size", "required": "byClass:comp_wearable", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；DF 按种族尺码", "owner": "卷三乙 §4.13"},
  "fitsSlot": {"type": "set", "of": {"type": "ref", "vocab": "attach_slot"}, "domain": {}, "required": "byClass:comp_attachment", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA#66", "owner": "卷三乙 §4.14"},
  "fragility": {"type": "number", "unit": "fraction", "domain": [0, 1], "precision": 4, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；九维之五", "owner": "卷三乙 §4.18"},
  "frameMassKg": {"type": "number", "unit": "kg", "domain": [0, null], "precision": 4, "derived": "卷十七 §2.3 登记：骨架槽所装部件质量之和", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷十七 §2.3 登记", "owner": "卷十七 §2.3"},
  "fuelClass": {"type": "ref", "vocab": "class", "nullable": true, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷三乙 §2.2；CDDA vehicle", "owner": "卷十七 §2.3"},
  "fuelEnergyMJ": {"type": "number", "unit": "MJ", "domain": [0, null], "precision": 4, "derived": "卷三乙 §4.17.1：总热量折算量", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2", "owner": "卷三乙 §4.17"},
  "guard": {"type": "struct", "fields": {"thicknessMm": {"type": "number", "unit": "mm", "domain": [0, null], "precision": 4}, "coverBps": {"type": "integer", "unit": "bps", "domain": [1, 10000]}}, "required": "byClass:comp_guard", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2 :215；卷十三 §2.3 :227、R13-3.3 :670（乘一万取整）登记；DF 01 第 3.1 节（thicknessMm 大于 0 由加载校验另判；coverBps 卷文只写 integer 与 [1,10000]。单位 bps；曾因资源单位 bps 撞名暂取 dimensionless，李白 11-19 18:1x ③ 裁定一个代号只许一个意思、资源单位改 asset_share_bp，卷六勘误 1119k9，已改回 bps）", "owner": "卷十三 §2.3"},
  "holdsLiquid": {"type": "boolean", "required": "byClass:comp_container", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA watertight", "owner": "卷三乙 §4.4"},
  "language": {"type": "ref", "vocab": "language", "required": "byClass:comp_readable", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；CDDA book", "owner": "卷三乙 §4.15"},
  "launch": {"type": "struct", "fields": {"source": {"type": "enum", "vocab": "launchsrc"}, "impulseCap": {"type": "number", "unit": "kg_m_per_s", "domain": [0, null], "precision": 4}, "dispersionMrad": {"type": "number", "unit": "mrad", "domain": [0, null], "precision": 4}, "reloadBeats": {"type": "integer", "unit": "count", "domain": [0, null]}, "chargeKg": {"type": "number", "unit": "kg", "domain": [0, null], "precision": 4, "nullable": true}, "missileClass": {"type": "ref", "vocab": "class"}}, "required": "byClass:comp_launcher", "onUnknown": "error", "modifiable": false, "source": "卷三乙 :216；卷十三 §2.3 登记（impulseCap 大于 0、source 取 charge 时 chargeKg 非空等跨字段校验归卷十三）；RW 03 第 15 节第 7 项", "owner": "卷十三 §2.3"},
  "layer": {"type": "enum", "vocab": "layer", "required": "byClass:comp_wearable", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；DF LAYER", "owner": "卷三乙 §4.13"},
  "lifeDays": {"type": "number", "unit": "day", "domain": [0, null], "precision": 4, "derived": "wearResistance / (wearPerUse * dailyUses)", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2", "owner": "卷三乙 §4.10"},
  "massKg": {"type": "number", "unit": "kg", "domain": [0, 100000], "precision": 4, "required": "always", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2、I-5（下限不含 0，加载校验另判）；CDDA weight；EVE mass", "owner": "卷三乙 §4.2"},
  "material": {"type": "list", "domain": {"maxSize": 12}, "of": {"type": "struct", "required": ["group", "materialRef", "share"], "fields": {"group": {"type": "ref", "vocab": "matgroup"}, "materialRef": {"type": "ref", "kind": "material"}, "share": {"type": "number", "unit": "fraction", "domain": [0, 1], "precision": 4}}}, "required": "always", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2、§4.2.1；CDDA portion；DF 多材料器物", "owner": "卷三乙 §4.2"},
  "maxLoadKg": {"type": "number", "unit": "kg", "domain": [0, 100000], "precision": 4, "required": "byClass:comp_container", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA pocket", "owner": "卷三乙 §4.4"},
  "modBudget": {"type": "number", "unit": "score", "domain": [0, 100], "precision": 4, "required": "ifPresent:modSlots", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；EVE 装配预算", "owner": "卷三乙 §4.14"},
  "modCost": {"type": "number", "unit": "score", "domain": [0, 100], "precision": 4, "required": "byClass:comp_attachment", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA#66", "owner": "卷三乙 §4.14"},
  "modSlots": {"type": "map", "key": {"type": "ref", "vocab": "attach_slot"}, "value": {"type": "integer", "unit": "count", "domain": [1, 8]}, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷三乙 §2.2；EVE 04 §9.1 #9", "owner": "卷三乙 §4.14"},
  "necessityTier": {"type": "enum", "vocab": "tier", "derived": "max(usageTier, rank(maxOf(rel_downstream_recipes, necessityTier), -1))", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2、C-3", "owner": "卷三乙 §4.3"},
  "origin": {"type": "ref", "kind": "place", "nullable": true, "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2；九维之一", "owner": "卷三乙 §4.3"},
  "pileFlammability": {"type": "number", "unit": "flam_index", "domain": [0, 1], "precision": 4, "derived": "卷三乙 §4.11 T-15：成堆整堆有效易燃度", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；李白 11-13 裁定（成堆规则）", "owner": "卷三乙 §4.11"},
  "possibleMatterStates": {"type": "set", "of": {"type": "enum", "vocab": "matter"}, "domain": {"maxSize": 3}, "derived": "卷三乙 §4.11 T-13：模板主料的可能物态集", "required": "never", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；李白 11-13 拆卷裁定", "owner": "卷三乙 §4.11"},
  "preserveMult": {"type": "number", "unit": "fraction", "domain": [0, 1], "precision": 4, "required": "byClass:comp_container", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；CDDA 02 §12.2", "owner": "卷三乙 §4.4、§4.12"},
  "produceSeason": {"type": "set", "of": {"type": "ref", "vocab": "season"}, "domain": {}, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2；九维之六", "owner": "卷三乙 §4.3"},
  "protection": {"type": "map", "key": {"type": "ref", "vocab": "damage"}, "value": {"type": "number", "unit": "dimensionless", "domain": [0, null], "precision": 4}, "derived": "卷三乙 §4.13：穿戴物防护，派生", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2", "owner": "卷三乙 §4.13"},
  "readMinutes": {"type": "integer", "unit": "minute", "domain": [1, 100000], "required": "byClass:comp_readable", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2；CDDA#64", "owner": "卷三乙 §4.15"},
  "saltPerKg": {"type": "number", "unit": "daily_ref_per_kg", "domain": [0, null], "precision": 4, "derived": "卷三乙 §4.17.1：每千克物品所含盐分的日参考量份数", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2（本版加）", "owner": "卷三乙 §4.17"},
  "satietyTotal": {"type": "number", "unit": "satiety", "domain": [0, null], "precision": 4, "derived": "卷三乙 §4.17.1：总饱腹折算量", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷三乙 §2.2", "owner": "卷三乙 §4.17"},
  "sealed": {"type": "boolean", "required": "byClass:comp_container", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA pocket", "owner": "卷三乙 §4.4"},
  "seasonUseFactor": {"type": "map", "key": {"type": "ref", "vocab": "season"}, "value": {"type": "number", "unit": "dimensionless", "domain": [0, null], "precision": 4}, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2；九维之六", "owner": "卷三乙 §4.3"},
  "selfMakeRecipe": {"type": "ref", "kind": "recipe", "nullable": true, "derived": "卷三乙 §4.3：家户能不能自己做，派生自配方表", "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2；九维之七", "owner": "卷三乙 §4.3"},
  "sharpness": {"type": "number", "unit": "score", "domain": [0, 100], "precision": 4, "derived": "edgeRatio × 承担组材料的 sharpnessMax", "required": "never", "onUnknown": "gap", "modifiable": true, "stacking": "none", "bounds": [0, 100], "source": "卷三乙 §2.2；DF MAX_EDGE", "owner": "卷三乙 §4.8、§4.13"},
  "shelfLifeDays": {"type": "number", "unit": "day", "domain": [0, 36500], "precision": 4, "derived": "卷三乙 §4.12：保质日数，派生", "allowExplicit": true, "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2；CDDA spoils_in", "owner": "卷三乙 §4.12"},
  "sizeClass": {"type": "enum", "vocab": "size", "derived": "lookup(rules.items.sizeClasses, volumeL)", "required": "never", "onUnknown": "gap", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2、I-1", "owner": "卷三乙 §4.2"},
  "sourceMode": {"type": "enum", "vocab": "source", "derived": "first(rules.items.sourceRules)", "allowExplicit": true, "required": "never", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2、C-2；九维之一", "owner": "卷三乙 §4.3"},
  "sourceStrength": {"type": "map", "key": {"type": "ref", "vocab": "sense"}, "value": {"type": "number", "unit": "sense_arrival", "domain": [0, null], "precision": 4}, "required": "always", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；卷五 §4.2 规则 7（封卷后勘误 1115c2）", "owner": "卷五 §4.2 规则 7、11"},
  "speedCapMpm": {"type": "number", "unit": "m_per_minute", "domain": [0, null], "precision": 4, "derived": "卷十七 R17-2.4：速度上限", "required": "never", "onUnknown": "gap", "modifiable": true, "stacking": "none", "bounds": [0, 1000000], "source": "卷十七 §2.3 登记", "owner": "卷十七 §2.3"},
  "substitutePool": {"type": "set", "of": {"type": "ref", "vocab": "pool"}, "domain": {"maxSize": 8}, "derived": "卷三乙 §4.17：池条目的成员条件推出", "required": "never", "onUnknown": "skip", "modifiable": false, "source": "卷二 §5.1；卷三乙 §2.2；九维之四", "owner": "卷三乙 §4.17"},
  "teaches": {"type": "set", "of": {"type": "ref", "kind": "knowledge"}, "domain": {}, "required": "byClass:comp_readable", "onUnknown": "error", "modifiable": false, "source": "卷二 §5.1；CDDA book", "owner": "卷三乙 §4.15"},
  "thicknessMm": {"type": "number", "unit": "mm", "domain": [0.1, 60], "precision": 4, "required": "byClass:comp_wearable", "onUnknown": "error", "modifiable": false, "source": "卷三乙 §2.2；CDDA 材料层", "owner": "卷三乙 §4.13"},
