:[],"terrain":"平地","openHours":[0,1440]},{"id":"loc_bs","name":"白石镇","coordinates":[24,0],"parent":null,"scope":"loc_hw","aliases":[],"terrain":"平地","openHours":[0,1440],"workstations":[{"id":"station_bs_small_kiln","kind":"pottery","owner":"loc_bs","fee":5,"access":"public"}]},{"id":"bld_hw_school","name":"小学堂","coordinates":[0.4,0.1],"parent":"loc_hw","scope":"loc_hw","aliases":[],"terrain":"平地","openHours":[420,1350]},{"id":"loc_hw_apiary","name":"南坡蜂场","coordinates":[0,-2],"parent":"loc_hw","scope":"loc_hw","aliases":[],"terrain":"平地","openHours":[0,1440]},{"id":"bld_hw_post","name":"小驿站","coordinates":[0.6,0],"parent":"loc_hw","scope":"loc_hw","aliases":[],"terrain":"平地","openHours":[420,1350]},{"id":"site_beilin_tower","name":"北林废观测塔","coordinates":[6,0],"parent":"loc_hw","scope":"loc_hw","aliases":["废观测塔"],"terrain":"平地","openHours":[0,1440]},{"id":"loc_yandu","name":"雁渡","coordinates":[0,-32],"parent":"loc_hw","scope":"loc_hw","aliases":[],"terrain":"平地","openHours":[0,1440]},{"id":"loc_capital","name":"王都","coordinates":[440,0],"parent":"loc_hw","scope":"loc_hw","aliases":[],"terrain":"平地","openHours":[0,1440]},{"id":"bld_hw_altar","name":"河湾石坛","parent":"loc_hw","scope":"loc_hw","aliases":[],"coordinates":[0.1,0.1],"terrain":"平地","openHours":[0,1440],"description":"村东的低矮石坛，坛沿刻着历年修补者的名字。登记簿保存在遮雨石龛里。冒险者在这里登记复活点，登记费留作清理石坛和维护石龛。","purpose":"复活登记祭坛"},{"id":"bld_bs_shrine","name":"白石归途殿","parent":"loc_bs","scope":"loc_bs","aliases":[],"coordinates":[24.1,0.1],"terrain":"平地","openHours":[0,1440],"description":"白石镇东门附近的石殿，门廊设有供远行者等候的长凳。殿中登记达到五级的冒险者，登记费供殿舍维护，已登记者可以重新选择这里作为复活点。","purpose":"复活登记祭坛"},{"id":"site_copper_ridge","name":"铜砾岭","aliases":[],"parent":"loc_bs","coordinates":[48,14],"terrain":"碎石丘陵","description":"红褐砾石铺满低岭，雨水冲出的细沟露着铜色石面。坡背矮苔之间留有龟爪划痕，岭鹿磨角的石棱比周围明亮。向西下坡可见通往白石镇的旧车辙。"},{"id":"site_root_hollow","name":"盘根洼","aliases":[],"parent":"site_copper_ridge","coordinates":[56,20],"terrain":"阔叶林谷","description":"几株老榆的根弯进浅潭，潭沿细泥留着鹿蹄与鸟足印。倒木的空腹积着深褐木浆，枝叶遮住东来的坡路；雨后行人得踩着外露的根绕过低洼处。"},{"id":"site_basalt_steps","name":"乌岩阶","aliases":[],"parent":"loc_bs","coordinates":[76,-14],"terrain":"玄岩台地","description":"黑色岩层一阶阶隆起，裂缝里长着短草和灰茎灌木。岩牛卧过的碎石窝里留着粗毛，风口的枯树有猿掌拍出的亮斑。北侧一条窄坡通向白石镇。"},{"id":"site_salt_reeds","name":"盐苇湾","aliases":[],"parent":"site_basalt_steps","coordinates":[92,-24],"terrain":"盐湿滩地","description":"灰白盐壳铺在高滩边缘，潮沟穿过成片苇根。退水后蚌壳与猪蹄印露在软泥上，走得太近会把半条腿陷进去。西北的硬土堤接回乌岩阶。"},{"id":"site_glass_dunes","name":"透砂坡","aliases":[],"parent":"loc_yandu","coordinates":[36,-78],"terrain":"沙丘与砾坡","description":"晨光穿过细砂露出亮点，沙驼啃过的干草茎向着背风坡倒伏。坡下几块浅色岩板替商旅挡住浮砂，北去的旧道两旁埋着磨圆的路石。"},{"id":"site_silt_canyon","name":"沉沙峡","aliases":[],"parent":"site_glass_dunes","coordinates":[49,-98],"terrain":"干旱峡谷","description":"峡底沉着细黄砂，岩壁阴处的灌木根撑住零星湿土。夜里兽道的爪印沿裂缝折返，白昼的风把谷口羽毛卷到石凹里。西北陡坡通向透砂坡。"},{"id":"site_rainstone_basin","name":"雨石盆地","aliases":[],"parent":"loc_yandu","coordinates":[-64,-86],"terrain":"湿林盆地","description":"盆地的雨水顺樟树纵沟滴进厚苔，林象踩出的泥窝常存着积水。折断的竹节挂在高枝上，傍晚能听到管蝠的短鸣。东北的石脊小径渐渐离开湿林。"},{"id":"site_peat_islets","name":"黑泥洲","aliases":[],"parent":"site_rainstone_basin","coordinates":[-82,-109],"terrain":"泥炭湿地","description":"黑泥分隔出低矮草洲，莎草根下冒着缓慢的水泡。高处的牛卧痕尚能承重，低处只见龙鳄背峰划开的水纹。沿东北硬泥脊可回到雨石盆地。"},{"id":"site_white_canopy","name":"白冠高林","aliases":[],"parent":"loc_capital","coordinates":[486,54],"terrain":"高地针阔混交林","description":"针叶与阔叶树挤在高地坡上，霜水沿浅灰树皮滴进落针层。白冠高麋常沿老木间隙留下宽蹄印，翻倒的小杉枝堵住东侧兽道。西南的坡道降向有人烟的河谷。"},{"id":"site_ice_echo","name":"冰回裂谷","aliases":[],"parent":"site_white_canopy","coordinates":[512,82],"terrain":"冰蚀裂谷","description":"裂谷两侧的岩面磨得平滑，积雪遮住窄缝底部。融雪渗口旁长着白皮桦，谷风一吹就有碎冰坠入深处。西南的高林道在冬季被雪封住。"},{"id":"site_red_fold","name":"赤褶山麓","aliases":[],"parent":"loc_capital","coordinates":[538,-46],"terrain":"赤色褶皱山地","description":"赤色岩褶从山脚斜向上拱，浅土里长着细硬的草。山犎角上沾着新翻出的湿土，巨猿搬过的枯枝在林缘排成一束。西北宽坡连回河谷大道。"},{"id":"site_moon_cliffs","name":"圆月断崖","aliases":[],"parent":"site_red_fold","coordinates":[566,-64],"terrain":"断崖与高山灌丛","description":"崖顶低灌木贴着石缝生长，浅灰鹏羽卡在向外突出的岩台上。月光照出白角鹿走过的苔边，冬雪把东南的崖路压成一条冰脊。西北缓坡接向赤褶山麓。"},{"id":"site_crown_firn","name":"冠雪台原","aliases":[],"parent":"site_ice_echo","coordinates":[572,146],"terrain":"高山粒雪台原","description":"粒雪铺在高台的石面上，风把迎风侧削成硬亮的雪壳。雪脂松的根后留下压实的槽，独角兽拨开的浅坑露出苔草。南去的陡路冬季积雪深过路石。"},{"id":"site_deep_star_bowl","name":"沉星山坳","aliases":[],"parent":"site_crown_firn","coordinates":[593,171],"terrain":"封闭高山岩坳","description":"岩壁围住狭长山坳，低处沉着细雪和夜里落下的碎石。星杉撑过的岩面留有三角根印，宽角圣犎卧在背风坡后的硬土上。西南缺口接向冠雪台原。"}]