[{"skill":"skill_life_6_core","minimumProficiency":0,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","learningRequired":true,"learnFee":4,"learnMinutes":30,"teachers":["npc_hw_ayan"],"difficulty":10,"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"scope":null,"aliases":[],"id":"recipe_wooden_pegs","name":"削制榫用木楔","minutes":20,"output":{"item":"item_wooden_peg","quantity":4},"byproducts":[{"item":"item_wood_shavings","amount":1}],"process":"沿直纹截取薄条，先削长斜面再截成四块木楔，在台上逐块试压；小刀逆纹时容易崩边。"},{"skill":"skill_life_6_core","minimumProficiency":0,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","learningRequired":true,"learnFee":4,"learnMinutes":30,"teachers":["npc_hw_ayan"],"difficulty":10,"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"scope":null,"aliases":[],"id":"recipe_tool_handle","name":"修整小工具木柄","minutes":30,"output":{"item":"item_tool_handle","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"process":"从无裂纹木料留出装柄端，顺纹削出握持弧度。装柄端留少量余量，交给使用者与具体工具配合。"},{"id":"recipe_mill_oats","name":"筛磨燕麦粉","aliases":[],"scope":null,"skill":"skill_life_0_core","minimumProficiency":0,"minutes":20,"difficulty":10,"workstation":"woodworking","process":"先在磨坊脱壳，再用已有磨盘碾细、筛出硬壳；小刀只用于开谷袋。剩壳另入不可食废堆。","materials":[{"item":"item_oats","amount":1}],"tools":["item_whittling_knife"],"output":{"item":"item_oat_flour","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[]},{"id":"recipe_bake_flatbread","name":"烙燕麦薄饼","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":35,"difficulty":10,"workstation":"cooking","process":"将粉、水和盐压成四片薄饼，以厚锅底小火烙到两面定形；不用酵种，不能写成发酵面包。","materials":[{"item":"item_oat_flour","amount":1},{"item":"item_water","amount":1},{"item":"item_salt","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot"],"output":{"item":"item_oat_flatbread","quantity":4},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[]},{"id":"recipe_cook_porridge","name":"熬干果燕麦粥","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":25,"difficulty":10,"workstation":"cooking","process":"切碎干果，水沸后缓入粉并不断搅锅底；分为两碗，锅边焦糊须弃，不混入合格份额。","materials":[{"item":"item_oat_flour","amount":1},{"item":"item_water","amount":2},{"item":"item_dried_fruit","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"output":{"item":"item_fruit_porridge","quantity":2},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[]},{"id":"recipe_curdle_milk","name":"凝制果醋鲜乳块","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":100,"minutes":40,"difficulty":15,"workstation":"cooking","process":"鲜乳加热后少量兑醋，凝结后沥去乳清，形成两块鲜乳凝块；乳清弃置，不叫长日熟成奶酪。","materials":[{"item":"item_milk","amount":2},{"item":"item_fruit_vinegar","amount":1},{"item":"item_charcoal","amount":1}],"tools":["item_cooking_pot"],"output":{"item":"item_fresh_curd","quantity":2},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_3_core","minimum":100}]},{"id":"recipe_salt_fish","name":"短腌小咸鱼","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":180,"difficulty":10,"workstation":"cooking","process":"顺鱼体划浅口，抹匀盐后放冷凉处三小时；留下的不是长期风干鱼，仍按三日保存期限处理。","materials":[{"item":"item_fish","amount":1},{"item":"item_salt","amount":1}],"tools":["item_kitchen_knife"],"output":{"item":"item_salt_fish","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[]},{"id":"recipe_spin_wool","name":"手纺粗毛线","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":60,"difficulty":10,"workstation":"weaving","process":"梳齐羊毛并逐段牵伸，用纺锤加捻，分成三团；短毛和断头不计作线团，不冒称丝线。","materials":[{"item":"item_wool","amount":1}],"tools":["item_spindle"],"output":{"item":"item_wool_yarn","quantity":3},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[]},{"id":"recipe_weave_linen","name":"织窄幅麻布","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":100,"minutes":180,"difficulty":15,"workstation":"weaving","process":"将已梳理纤维纺成经纬线，设经后逐行织紧，裁下规定长度；余经头弃置，不复制整匹布。","materials":[{"item":"item_flax","amount":2}],"tools":["item_spindle","item_loom"],"output":{"item":"item_linen_cloth","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_4_core","minimum":100}]},{"id":"recipe_dip_candles","name":"浸制细蜂蜡烛","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":30,"difficulty":10,"workstation":"cooking","process":"从麻束搓出四条细芯，在微热蜡液中反复浸挂，四支成形后放凉；余麻不生成无限灯芯。","materials":[{"item":"item_beeswax","amount":1},{"item":"item_flax","amount":1},{"item":"item_charcoal","amount":1}],"tools":["item_cooking_pot"],"output":{"item":"item_wax_candle","quantity":4},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[]},{"id":"recipe_fire_cup","name":"拉烧小陶杯","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":100,"minutes":600,"difficulty":15,"workstation":"pottery","process":"揉泥后拉三只小杯，低热干坯再在小窑升火烧成，缓慢冷却；裂坯与烧灰弃置，不变成可用杯。","materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"output":{"item":"item_clay_cup","quantity":3},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":100}]},{"id":"recipe_fire_pot","name":"拉烧素面陶罐","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":150,"minutes":720,"difficulty":15,"workstation":"pottery","process":"拉出宽肚小罐，保持口沿同厚，干坯与逐步升温后缓冷；不带釉，罐盖需另配。","materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"output":{"item":"item_clay_pot","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":150}]},{"id":"recipe_forge_nails","name":"锻制小铁钉","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":0,"minutes":80,"difficulty":10,"workstation":"smithing","process":"把铁坯拉成细条，逐节截断并锻钉头，冷却检直；氧化皮与断头不可计入四十枚成品。","materials":[{"item":"item_iron","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_smith_hammer","item_smith_tongs"],"output":{"item":"item_iron_nail","quantity":40},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[]},{"id":"recipe_forge_hinge","name":"锻制门柜铰链","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":100,"minutes":120,"difficulty":15,"workstation":"smithing","process":"分出两片叶片与销轴，卷耳后对轴装合，开闭检验再收工；较大余料留为铁边料一份。","materials":[{"item":"item_iron","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_smith_hammer","item_smith_tongs"],"output":{"item":"item_iron_hinge","quantity":1},"byproducts":[{"item":"item_iron_scrap","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[{"skill":"skill_life_5_core","minimum":100}]},{"id":"recipe_sew_sack","name":"缝制麻布粮袋","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":45,"difficulty":10,"workstation":"weaving","process":"裁定袋身并穿粗眼针缝合双折口，小刀只切割布；针与小刀必须实际持有，不随成品带走。","materials":[{"item":"item_linen_cloth","amount":1},{"item":"item_wool_yarn","amount":1}],"tools":["item_whittling_knife","item_sewing_needle"],"output":{"item":"item_grain_sack","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":120,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[]},{"id":"recipe_w3_oat_crisp","name":"制作无盐燕麦脆片","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":45,"difficulty":10,"materials":[{"item":"item_oat_flour","amount":1},{"item":"item_water","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_oat_crisp","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一袋燕麦粉与一份清水，在厚底煮锅内直接混合，不加酵种，也不加盐。用手或切刀背把湿粉压合成整块，不必揉出筋性，只需压到能成片、不散开。把粉团移到案上，用切刀背逐次压薄，压成约两指宽的长条薄片，边压边把裂口按回。厚底煮锅置小灶上，小火预热后放入薄片，慢烙至两面干爽、边缘微翘，中途翻面一次。烙好的薄片摊开，借灶上余温慢慢烘去水汽，全程约四十五分钟，含烙与烘干。干木刨屑只在需要引火时使用，不接触食物。成品为无盐燕麦脆片，可掰碎泡汤，咸味须另加盐。"},{"id":"recipe_w3_milk_oat_mash","name":"制作乳香燕麦糊","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":25,"difficulty":10,"materials":[{"item":"item_oat_flour","amount":1},{"item":"item_milk","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_milk_oat_mash","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取燕麦粉一袋倒入厚底煮锅，先用案上切刀背把结块压散，免得入乳后抱团。鲜牛乳小壶当日开用，分三四回缓缓淋入粉中，每回都用木匙贴着锅底画圈拌开，让粉粒吃透乳再添下一回。锅坐小灶上，火不宜猛，隔锅底不停搅动，见糊面起细泡、纹路能挂住匙背即成稠糊，可用匙舀取。全程约二十五分钟，中途若糊体扑出，灶边备一小撮干木刨屑撒上吸去漏液，湿屑弃去不再引火。煮好即盛出，趁温给牙口弱的食客当餐吃。"},{"id":"recipe_w3_fruit_paste","name":"制作醋煮干果酱","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_dried_fruit","amount":1},{"item":"item_fruit_vinegar","amount":1},{"item":"item_water","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_fruit_paste","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一袋干果（一百五十克）与二百五十毫升清水同入厚底煮锅，浸至果肉回软，约需两刻钟；泡过的水带果香，别倒掉。连水带果移上小灶，添五十毫升酸果醋，中火煮沸后转小火，用案上切刀把大块果肉压碎、切细，边煮边搅，防锅底结焦。煮到汤汁收浓、木勺划过能留下短痕即成粗酱，前后约三十五分钟（含浸软等待）。全程不加糖，酸甜全靠果肉与果醋。得醋煮干果酱一份，无副产物。蘸薄饼随餐食用，三日之内吃完。"},{"id":"recipe_w3_fish_oat_cake","name":"制作碎鱼燕麦烙饼","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":100,"minutes":40,"difficulty":15,"materials":[{"item":"item_fish","amount":1},{"item":"item_oat_flour","amount":1},{"item":"item_salt","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_fish_oat_cake","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_3_core","minimum":100}],"process":"取剖净鲜鱼一条，用案上切刀贴骨剔下鱼肉，指腹顺纹摸查，把细刺一并挑出，鱼刺弃置。将鱼肉剁成粗碎，混入燕麦粉与粗盐，盐若含沙先筛拣；不另加水，靠鱼肉自身水分揉成黏团。把黏团分成小份，用刀背逐份轻压，使厚薄均匀，压成薄饼。厚底煮锅坐火上烧热，取干木刨屑少许引火，锅热后放入薄饼，两面烙至表面干爽、边缘微黄即可取出。焦屑刮去弃置，不可混入饼中。全程约四十分钟，含锅具预热与翻面等待。成品一张，当日食用。"},{"id":"recipe_w3_fish_broth","name":"制作清煮鱼汤","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":30,"difficulty":10,"materials":[{"item":"item_fish","amount":1},{"item":"item_water","amount":2},{"item":"item_salt","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife","item_wood_spoon"],"workstation":"cooking","output":{"item":"item_fish_broth","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取剖净鲜鱼一条，用案上切刀沿脊骨剖开，剔去鳃与腹内残血，再横切成两指宽的块，鱼刺仍留在肉里，不必强求剔尽。厚底煮锅置灶上，倒入清水两份，投干木刨屑引火，烧至锅底冒细密气泡而未大滚时下鱼块。汤面浮起灰白沫子，用偏柄木匙沿锅边撇净，火候保持微沸，煮到鱼肉由透明转白、用刀尖轻拨即散。此时撒入粗盐，以刀背压碎结块再下，搅匀后尝一口，咸淡以能辨出鱼鲜为度。全程30分钟，起锅后趁热分盛，汤清不浑；分食时仍须挑骨，清汤不含未列的药草。锅与刀用后洗净擦干，免得内锈。"},{"id":"recipe_w3_warm_vinegar_drink","name":"制作温果醋饮","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":15,"difficulty":10,"materials":[{"item":"item_fruit_vinegar","amount":1},{"item":"item_water","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_warm_vinegar_drink","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"将一份清水倒入厚底煮锅，开封一小瓶果醋，量入本瓶五十毫升醋，轻晃锅身使两种液体混匀。灶内放一份干木刨屑供火，把锅放稳，以小火温热到液面冒出淡汽便离火；不需重新发酵。连同备料与温热共15分钟，得到一份带酸味的佐餐饮品。锅底若有沉渣，倒出时留在锅内弃置，不另作副产品。成品当天饮用，杯子另备。"},{"id":"recipe_w3_fruit_milk_pudding","name":"制作干果乳粉糕","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":100,"minutes":50,"difficulty":15,"materials":[{"item":"item_milk","amount":1},{"item":"item_oat_flour","amount":1},{"item":"item_dried_fruit","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife","item_mixing_paddle"],"workstation":"cooking","output":{"item":"item_fruit_milk_pudding","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_3_core","minimum":100}],"process":"取干果小袋，以案上切刀切成细碎果粒，刀面压过果肉时能感到韧中带沙。鲜牛乳小壶倾入厚底煮锅，兑入燕麦粉，用长柄搅糊板搅成无干粒的稠糊，再拌入果粒。灶下以干木刨屑引火，火势压小，锅底垫稳，文火慢凝，其间不停刮底，糊体由稀转厚、表面泛起细密气泡时离火。整锅移开静置冷却，待糕体定形后倒出，以切刀分作小块。成品软糯带果香，当天吃完；锅壁焦糊处趁温泡软再刷净。"},{"id":"recipe_w3_toasted_oats","name":"制作锅焙燕麦粒","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_oats","amount":1},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_toasted_oats","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一袋带壳燕麦，用手搓去壳，再把轻壳从谷粒间拣出，避免硬壳混入。灶内投入一份干木刨屑供火，厚底煮锅受热后倒入谷粒，握住锅柄轻晃、翻锅，使谷粒滚动受热；刀只用于开袋，不压谷壳。连同脱壳与翻焙共35分钟。闻到焙香、粒面干爽后离火放凉，收成一份锅焙燕麦粒；轻壳与焦屑弃置。成品仍硬，通常再煮粥。"},{"id":"recipe_w3_salted_curd","name":"制作压盐鲜乳饼","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":100,"minutes":45,"difficulty":15,"materials":[{"item":"item_fresh_curd","amount":2},{"item":"item_salt","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_salted_curd","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_3_core","minimum":100}],"process":"取两块果醋鲜乳凝块置于案上，用切刀刀背压碎，再以手捏散至无大颗粒。粗盐先摊在案面挑去沙粒，用刀背碾细，撒入凝块碎中拌匀。拌好的乳碎移入厚底煮锅，用锅底或手掌将其压成紧实一饼，压时可见少量乳清从锅沿渗出，倾出乳清即可。全程约四十五分钟，含压紧与沥去乳清的时间；成品为一块压盐鲜乳饼，无副产物，不经熟成，须在两日内食用。"},{"id":"recipe_w3_fruit_oat_dumpling","name":"制作干果燕麦团","aliases":[],"scope":null,"skill":"skill_life_3_core","minimumProficiency":100,"minutes":40,"difficulty":15,"materials":[{"item":"item_oat_flour","amount":1},{"item":"item_dried_fruit","amount":1},{"item":"item_water","amount":2},{"item":"item_wood_shavings","amount":1}],"tools":["item_cooking_pot","item_kitchen_knife"],"workstation":"cooking","output":{"item":"item_fruit_oat_dumpling","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_linsui"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_3_core","minimum":100}],"process":"将干果切碎待用。两份清水先留一小部分分次润入燕麦粉，揉成没有干粉夹心的硬粉团，其余倒入厚底煮锅供煮制；两处用水合计仍是两份。粉团分小块，包入果碎并捏紧收口，以干木刨屑供火，锅水沸后放入小团，轻晃锅身防粘。煮至中心熟透后离火，倾锅沥水，弃去残汤。全程40分钟，得到一份干果燕麦团，无副产物；外皮结实，放凉会变硬。"},{"id":"recipe_w3_linen_apron","name":"制作交背麻围裙","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":65,"difficulty":10,"materials":[{"item":"item_linen_cloth","amount":1},{"item":"item_wool_yarn","amount":1}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_linen_apron","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"把窄幅麻布摊在织坊案上，按挡胸与裙身量好宽长，用削木小刀削一支木楔压住布角，再拿粗眼缝针挑出布边的一根纬线，抽出后顺势撕开，断口比剪的更直。挡胸上缘折两指宽，裙身两侧各留一段布边，折成两条交背带，带根搭在挡胸上角。粗毛线穿粗眼缝针，从带根起针，来回三趟缝成一小片密实的受力点，再把折边压平走一道平针。缝完抖开，把带子交叉试围一下肩背，松紧以不勒腋下为准。整件从裁到缝约六十五分钟，中途不歇。成品是一条交背麻围裙，没有剩下可另作他用的副产物。"},{"id":"recipe_w3_pot_wrap","name":"制作夹层锅布","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":45,"difficulty":10,"materials":[{"item":"item_linen_cloth","amount":1},{"item":"item_wool","amount":1}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_pot_wrap","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"把窄幅麻布平铺在织坊台面上，取洗净羊毛束用手扯松，摊成与麻布等宽的一层薄絮，厚薄要匀，边角不留空。将麻布对折裹住羊毛，四边向内折进一指宽，用粗眼缝针穿粗线沿边绗缝，针脚相隔约两指，走线要直，免得羊毛在夹层里堆成团。缝完再在布面中间加两道平行绗线，把絮层压住。削木小刀只用来修整木台面上的毛刺，不碰布边。整件缝好后折叠成双层，压实边缘。连扯絮带缝制约需四十五分钟，成品一块夹层锅布，无副产物。只供短时隔热，不能抓明火里的铁钳。"},{"id":"recipe_w3_needle_roll","name":"制作卷式针包","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":40,"difficulty":10,"materials":[{"item":"item_linen_cloth","amount":1},{"item":"item_wool_yarn","amount":1}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_needle_roll","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一段窄幅麻布铺在织坊台上，按针长量出袋深，用削木小刀在布边轻划一道浅痕作折线，再以指腹压出折印——麻布硬挺，折痕要压实才不弹回。沿折线折出若干浅袋，袋口朝同一侧，逐道用粗眼缝针穿粗毛线缝合，针脚保持匀密，太疏则针尖会从缝隙钻出。缝完把长边自一端卷拢，卷到末端时用剩余毛线绕两圈系住，打结收紧，剪去浮线头。全程40分钟，其中大半花在折印与逐道缝合上。成品交付时不附针。"},{"id":"recipe_w3_herb_pouch","name":"制作透气药草袋","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_linen_cloth","amount":1},{"item":"item_wool_yarn","amount":1}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_herb_pouch","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一段窄幅麻布，先量出袋身与袋口折边的尺寸，用削木小刀在木板上比齐布边、压住布角，使裁口平直；随后以粗眼缝针穿粗毛线，把袋身两侧对折缝合，针脚走密，收针时把线尾压进缝道内。袋口先向外折一道窄边，再向内折回，沿折边疏缝一圈，留出一段可穿绳的通道，不把通道两端缝死。缝好后把袋身翻正，从通道穿入一段粗毛线作束绳，两端打结，试拉松紧。全程含缝制与整理约三十五分钟，成品为一只透气药草袋。麻袋只便于透气，装已晒干且辨认好的草药，不延长药草自身期限。"},{"id":"recipe_w3_head_wrap","name":"制作遮尘麻头巾","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":25,"difficulty":10,"materials":[{"item":"item_linen_cloth","amount":1}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_head_wrap","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一段窄幅麻布，先按头围量出方布尺寸，用削木小刀沿直纹裁成整块方布，落刀要顺纹走，逆纹容易把布边拉毛。裁下的窄边不丢，用手指搓成细线，穿进粗眼缝针，沿方布四边一针压一针地锁住布边，免得日后洗用散线。锁边时针尖别硬顶布缝，弯了会卡住。整块布再对折压出中线，摊平收好。前后约二十五分钟，得一条遮尘麻头巾，无副产物。磨坊里包住头发挡细灰，布纹仍会透过细尘。"},{"id":"recipe_w3_wool_wristband","name":"制作针缝毛腕套","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":100,"minutes":60,"difficulty":15,"materials":[{"item":"item_wool_yarn","amount":4}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_wool_wristband","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_4_core","minimum":100}],"process":"取四团粗毛线，用手指挑开线头的乱结，把浮毛拣去，再以粗眼缝针引线。从开口处起针，逐圈缠结，每绕一圈便把线圈压向已缝部分，使圈结紧密而不叠死；套上手腕试围，开口须留活动余量。两只腕套缝得长短相近，收口时把线尾穿回内侧藏住，不缝手指部分。连同整理线头和试围共60分钟，成品为一对针缝毛腕套，无副产物。"},{"id":"recipe_w3_linen_filter","name":"制作宽口滤布","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_linen_cloth","amount":1}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_linen_filter","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一段窄幅麻布平铺在织坊的台面上，先量出要搭在容器口上的宽度，用削木小刀在布边划一道浅痕作记，再顺着布纹裁下。裁口会散出细丝，须把毛边折进一指宽，用粗眼缝针穿上粗线，沿折边一针压一针缝实，针脚要匀，太密会抽紧布面，太疏则边丝仍会漏出。缝完把布抖开，四边都锁住才算成型。整件约需三十五分钟，其中大部分工夫花在锁边这一道上。做成的宽口滤布搭在已有容器上，可滤出大颗粒，但过滤并不使水获得饮用保证。"},{"id":"recipe_w3_patch_bundle","name":"制作锁边补衣片","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":40,"difficulty":10,"materials":[{"item":"item_linen_cloth","amount":1}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_patch_bundle","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一段窄幅麻布，先量好要补的破口大小，用削木小刀在布上划出方、三角、长条等不同形状的补片。刀尖要顺着布纹走，逆纹容易把边丝挑毛。裁下后，用粗眼缝针穿入从裁下布边抽出的麻丝，给每片补片锁一圈边，针脚压住散出的麻丝，免得日后越磨越散。锁完边把补片按大小叠成一包，用余线松松捆住。整件活计约需四十分钟，其中裁片与锁边占去大半，剩下的时间用来把叠好的补片压平定型。成品是一包锁边补衣片，用于破衣局部修补，需另备缝线。"},{"id":"recipe_w3_flax_cord","name":"制作三股麻绳","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":0,"minutes":50,"difficulty":10,"materials":[{"item":"item_flax","amount":2}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_flax_cord","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取两束梳理麻纤维，先用手掌把纤维理成顺向的长缕，再用粗眼缝针把乱结挑开，使每缕粗细大致均匀。把长缕分成三份，各份先在掌下向前搓捻成单股，捻到股身发紧、表面起细毛圈为止。三股并拢，用削木小刀在股尾划出浅痕作记号，随后朝单股相反的方向合捻，边捻边让三股互相咬住，直到绳身圆实、不见散丝。捻到末端时把三股捻尾折回，压进上一段绳缝里收住。全程50分钟，成绳一条，只作日常绑扎，不是攀岩保险绳。"},{"id":"recipe_w3_felt_seat","name":"制作压毡坐垫","aliases":[],"scope":null,"skill":"skill_life_4_core","minimumProficiency":100,"minutes":90,"difficulty":15,"materials":[{"item":"item_wool","amount":2},{"item":"item_water","amount":2}],"tools":["item_sewing_needle","item_whittling_knife"],"workstation":"weaving","output":{"item":"item_felt_seat","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_sulan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_4_core","minimum":100}],"process":"取两份洗净羊毛束置于织坊台面，先用手把毛束撕松，剔除明显结块与夹带的草屑。将净毛分作数层，一层横向、一层纵向交错铺开，铺幅略大于坐垫成品，使各层厚薄均匀。分次洒下清水，水量以毛层润透而不淌流为准。随后用手掌压住毛层反复揉搓推压，边角处向内折回再揉，直到毛纤维互相缠结、整片不再分层松散，压合成毡。揉压约需大半个时辰，中途可停下查看是否还有干毛未沾湿。成毡后摊平，置于阴凉通风处阴干，不可日晒急干，待毡片干透变挺即可作薄坐垫使用。全程不使用粗眼缝针与削木小刀，工具仅备而不用。"},{"id":"recipe_w3_wood_spoon","name":"制作偏柄木匙","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_wood_spoon","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[],"process":"取一段无裂的直纹小木料，用削木小刀顺纹削出浅匙腹，再让柄向一侧略偏，舀汤时能贴着锅缘转。全程约三十五刻，木料、刀与工作台各就各位，成一件偏柄木匙，另收一份干刨屑。难点在顺纹走刀：逆纹下刀会崩口，匙腹薄处也易豁。削完用指腹摸过边缘，有毛刺再轻修一刀，不靠水磨。"},{"id":"recipe_w3_mixing_paddle","name":"制作长柄搅糊板","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_mixing_paddle","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[],"process":"取一段无裂的木料，在木工台上用削木小刀顺着纹路削出宽而扁的头部，再把两侧边角倒圆，免得搅糊时刮伤锅底。柄身削到合手粗细，柄端留出一截握持处，不削尖。全程逆纹下刀容易崩口，头部越薄越要放慢，削完用手掌顺边摸一圈，确认没有毛刺。约三十五分钟可得一把长柄搅糊板，同时落下一百克干木刨屑，可留作引火。削好后放在通风处，让木面干透再用。"},{"id":"recipe_w3_spindle_whorl","name":"制作木纺轮片","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_spindle_whorl","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[],"process":"取一公斤木料，先看端面有无裂纹，顺纹劈出一块厚薄均匀的方片，再用削木小刀沿四边向中心削去棱角，使轮廓渐成圆片。削时刀口略微外斜，避免逆纹崩口；圆片两面轮流修薄，直到手捻边缘不刮指。随后在圆心用刀尖从两面各刻半孔，对穿成通轴孔，孔壁要直，不可一边大一边小。取纺锤杆试装，若过紧只可少量修孔，以杆能稳插又不晃动为准。全程约需三十五分钟，削下的干木刨屑另行收存。成品为一片替换用木纺轮，不附整套纺锤。"},{"id":"recipe_w3_shuttle","name":"制作尖梭织纬器","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":100,"minutes":45,"difficulty":15,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_shuttle","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[{"skill":"skill_life_6_core","minimum":100}],"process":"取一段两公斤内的通用木料，先看纹理走向，挑无裂、无节疤的一段下料。用削木小刀顺着木纹把坯体修成中间略厚、两端渐收的长条，两头各削出尖头，刀口要收住，只留圆钝的尖，不用力戳刺，免得留下锐刺。随后在中段两侧对称挖出绕线凹槽，槽壁要平顺，不夹线、不挂丝。削下的干木刨屑随手收拢，可留作引火或吸液之用。整个过程约四十五分钟，含削形、挖槽与修整；木料受潮或逆纹下刀时容易崩口，需放慢进刀。做完的尖梭用于窄幅织架引纬，不承担开经。"},{"id":"recipe_w3_weaving_sword","name":"制作压纬木片","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":100,"minutes":40,"difficulty":15,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_weaving_sword","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[{"skill":"skill_life_6_core","minimum":100}],"process":"取一公斤通用木料，先看有无裂纹，顺纹劈出比成品略厚的长条。用削木小刀沿纹路一层层削薄，刀口要顺着木丝走，逆纹下刀容易崩口，薄片也就废了。削到宽面平整、厚薄匀称后，把棱边和两面磨去毛刺，手摸不挂线即可。整块薄片要留出压纬的宽度，边缘保持平直，不能刻出齿口。前后约四十分钟，得压纬木片一件，另收干木刨屑一百克。削好的木片放在干燥处，避免受潮翘曲。"},{"id":"recipe_w3_boot_form","name":"制作短靴木撑","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":100,"minutes":70,"difficulty":15,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_boot_form","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[{"skill":"skill_life_6_core","minimum":100}],"process":"取一段无裂的木料，先看年轮走向定出脚背与后跟的朝向，再用削木小刀顺纹削薄。刀锋沿木纹推进，圆脚背处要一层层收圆，后跟两侧对称收窄，底面削平以便立放，全程约七十刻。逆纹下刀会崩口，遇到硬节就绕开，宁可多走几刀。削下的干木刨屑留作引火。成形后用手掌抚过脚背与后跟，确认弧线顺滑、底面平稳，尺码按靴样定死，不做伸缩余地。撑住湿靴定型，底面平放不歪。"},{"id":"recipe_w3_darning_egg","name":"制作补袜木卵","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":0,"minutes":40,"difficulty":10,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_darning_egg","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[],"process":"取一段无裂的木料，持削木小刀先顺着木纹把四角削去，削出大致椭圆；再细修两端，使两端略收而中段饱满，最后把表面粗糙凸棱逐层削平，指腹抚过不觉挂手即可。全程约四十分钟，逆纹下刀会崩口，故每刀宜浅，宁可多走几遍。削下的干木刨屑收作一份。成品放进袜内托住破洞，绷住四周布面，便于重新织补；不用时保持干燥，避免受潮变形。"},{"id":"recipe_w3_line_winder","name":"制作八字绕线板","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_line_winder","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[],"process":"取一公斤木料，先顺着纹理劈成薄片，再用削木小刀把两面刮平，厚薄以拇指与食指捏得住为准。片身修成窄长条后，在两端各刻一道浅叉，叉口只入木两三分，能卡住线即可；侧边全部倒圆，免得毛刺挂线。刻叉时木片最易顺纹劈裂，下刀要浅、要慢，宁可多走几刀。削下的干木刨屑约一百克，收进布袋留作引火。整块板打磨到摸不出棱角，空板即可出售，不附渔线或纱线；买家自行把线绕成八字，线便不易松脱。从削片到收尾约需三十五分钟。"},{"id":"recipe_w3_door_wedge","name":"制作宽背门挡楔","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":0,"minutes":25,"difficulty":10,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_door_wedge","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[],"process":"取一公斤木料，先看年轮走向，挑直纹无裂的一段下刀。用削木小刀从一端斜削出宽斜面，刀口顺纹推进，削到斜面平顺不跳刀；另一端留住厚度，修成便于捏取的宽背。中途翻面比对两侧坡度，让薄端能塞进门缝、厚端不硌手。约二十五分钟削成，落下的干木刨屑收作一份。成品塞入门缝可阻止轻微摆动，不代替门锁。"},{"id":"recipe_w3_seed_marker","name":"制作槽头播种牌","aliases":[],"scope":null,"skill":"skill_life_6_core","minimumProficiency":0,"minutes":35,"difficulty":10,"materials":[{"item":"item_wood","amount":1}],"tools":["item_whittling_knife"],"workstation":"woodworking","output":{"item":"item_seed_marker","quantity":1},"byproducts":[{"item":"item_wood_shavings","amount":1}],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_ayan"],"toolWear":1,"failure":{"recoverFraction":0,"injury":1},"prerequisites":[],"process":"取一截无裂的木料，先顺纹削出宽牌面，再收窄下端削成短尖脚，尖脚要能插进苗床松土而不折。牌面削平后，用刀尖在顶端刻一道浅槽，槽口宽度以能夹住纸签为准，太深易劈、太浅夹不住。全程逆纹处要放慢下刀，免得木面崩出毛刺。削下的干木刨屑收作一份副产物。成品交付时牌面空白，不写作物名，由用的人自己夹签辨认。连削带修约需三十五分钟。"},{"id":"recipe_w3_s_hook","name":"制作双弯铁挂钩","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":0,"minutes":45,"difficulty":10,"materials":[{"item":"item_iron_scrap","amount":1},{"item":"item_charcoal","amount":1}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_s_hook","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[],"process":"取一块铁边料，先验锈裂，挑无深裂者入炉。小袋木炭烧旺，用长柄铁钳夹坯，锻工手锤在砧上反复打细，边打边翻，让料身匀称。中段留直，两端分别向相反方向弯出钩形，弯时钳口夹稳，锤面轻敲定形，避免扁折。钩尖在砧缘磨钝，不留刺手尖锋。全程约四十五分钟，含炉火等待与冷定。成品一件双弯挂钩，无副产物，火灰留在炉内。吊挂轻锅与器具，未设承重上限。"},{"id":"recipe_w3_iron_awl","name":"制作锥尖穿孔针","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":0,"minutes":50,"difficulty":10,"materials":[{"item":"item_iron_scrap","amount":1},{"item":"item_charcoal","amount":1}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_iron_awl","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[],"process":"取一块铁边料，先看断面有无锈裂，挑出可回炉的实心部分。木炭小袋投入小炉生火，把边料埋进炭层里烧到透亮，用长柄铁钳夹出放到砧上。先以锻工手锤把料块打成长条，反复翻面，让锥身从粗到细均匀收下去，中途回炉补热，避免边打边裂。锥身成形后，一端留出足够长度，用锤缘慢慢卷成握环，环口收拢但不咬死；另一端收成短尖，尖头不宜过长，免得受力弯折。整件在炭火余温旁缓慢冷却，不可浸水急冷。冷却后试套握环是否顺手，查看锥尖是否偏弯、是否有明显裂痕。全程50分钟，含冷却等待。成品只有这一根穿孔针，不另出副产物。"},{"id":"recipe_w3_belt_buckle","name":"制作折舌腰带扣","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":100,"minutes":60,"difficulty":15,"materials":[{"item":"item_iron_scrap","amount":1},{"item":"item_charcoal","amount":1}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_belt_buckle","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[{"skill":"skill_life_5_core","minimum":100}],"process":"先验边料：翻看断面有无锈层夹渣，有裂的挑出不用，合格的入炉。小炉铺一袋木炭，鼓风烧到铁色转亮橙，用长柄铁钳夹出放砧上，锻工手锤先粗打去棱，把料分作框环与舌片两段。框环一段弯成方口，接口处叠压后趁热锤合，锤面要平，落点偏了接口就起皱。舌片一端收窄成尖，另一端卷出套孔，套孔套进框环横梁，再轻锤收口，使舌能绕梁转动而不脱出。全程约一小时，含中途回炉与收尾冷定。锻完趁冷试开合：舌片应能贴合框口，松手不歪倒，卡滞处用锤轻校。成品只此一件扣件，皮带另备；炉内火灰留在炉中，不另作料。"},{"id":"recipe_w3_seam_rivet","name":"制作短身皮铆钉组","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":100,"minutes":65,"difficulty":15,"materials":[{"item":"item_iron_scrap","amount":1},{"item":"item_charcoal","amount":1}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_seam_rivet","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[{"skill":"skill_life_5_core","minimum":100}],"process":"取铁边料小块一份，先验锈裂，挑无深裂者入炉。木炭小袋一份装炉，鼓风至红亮，用长柄铁钳夹坯出炉，在砧台上以锻工手锤收成短杆，再镦扁头，杆身要直、头面要平。同炉余热另锻四枚小垫片，与钉身配成一组。全程约六十五分钟，含中途回炉与冷定等待；钳口须夹稳，落锤偏了杆会弯。冷后逐枚对光看头面与杆根，弯杆可轻校，裂口则回炉。成品四枚一组，垫片随组收存。"},{"id":"recipe_w3_lamp_bracket","name":"制作折臂灯托","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":100,"minutes":100,"difficulty":15,"materials":[{"item":"item_iron","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_lamp_bracket","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[{"skill":"skill_life_5_core","minimum":100}],"process":"取一份两公斤铁料入炉，配两小袋木炭鼓风升温，待坯色转亮橙再以长柄铁钳夹出。先以锻工手锤在砧上收出尾片，趁热冲打安装孔，孔缘毛刺随即回火轻敲修平。再夹持中段弯出折臂，弯处要匀，不可一次折死，以免臂身起裂。臂端另锻浅托圈，圈口略外翻，便于托住已有油灯。全程连烧带打约一百分钟，冷后以指腹沿臂背摸过，察有无暗裂与偏弯。成品一件，无副产物，安装钉与灯都需另备。"},{"id":"recipe_w3_fire_poker","name":"制作钩头拨火杆","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":0,"minutes":80,"difficulty":10,"materials":[{"item":"item_iron","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_fire_poker","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[],"process":"取一份两公斤铁坯入炉，配两小袋木炭鼓风烧至亮红，用长柄铁钳夹出置于砧面。先以锻工手锤把铁坯反复锻打拉长，中途回炉补火，直到成为一根匀直长杆。杆身成形后，趁热把一端弯出浅钩，钩口不必深，能勾住炭块即可；另一端向内卷成握环，环径以手能穿过为准。整根拨火杆不另装木柄，握环与钩头都靠铁料自身弯成。全程80分钟，含回炉等待。锤痕留在杆身，冷后即可使用，无副产物。"},{"id":"recipe_w3_hearth_trivet","name":"制作三脚铁锅架","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":100,"minutes":130,"difficulty":15,"materials":[{"item":"item_iron","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_hearth_trivet","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[{"skill":"skill_life_5_core","minimum":100}],"process":"把整块铁料按托圈与三脚的需要分段下料，先锻托圈：将铁段烧至亮红，用长柄铁钳夹稳，以锻工手锤在砧上弯成环口，两端留出搭接的余量，趁热轻敲使接口贴合。再分锻三脚，每只脚从铁段一端收出略尖的落地点，另一端留出与托圈相铆的扁头，三只脚的长度要互相比对，避免长短不一。接着把托圈与三脚搭接处重新烧红，用铁钳夹住对齐，以手锤热铆相接，铆点要压实不松。全部接好后放到平整处试稳，看三脚是否同时着地、托圈是否水平，若歪斜则趁热轻敲校正。整个过程约一百三十分钟，含分段加热与铆接等待，成品为一件三脚铁锅架，供厚底煮锅离炭，不附锅具。"},{"id":"recipe_w3_chain_link_set","name":"制作锻接短链节","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":100,"minutes":110,"difficulty":15,"materials":[{"item":"item_iron","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_chain_link_set","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[{"skill":"skill_life_5_core","minimum":100}],"process":"先烧红铁料拉成细条，按六节用量截断。每节趁热在砧边卷成环，环口搭接后夹紧，用锤轻敲使接口贴合，再入炉烧至亮红，取出快速锻打闭合，落点要准，偏锤会把环口砸歪。逐环成形后，把前环穿入后环再卷合，依次连接成六节短链。全程约一百一十分钟，含反复回炉与接口冷却的等待。锤面与钳口留下的压痕会留在环身，属正常锻痕。只作门栓拉手，不作起重链。"},{"id":"recipe_w3_scraper_blade","name":"制作平口刮木片","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":100,"minutes":60,"difficulty":15,"materials":[{"item":"item_iron_scrap","amount":1},{"item":"item_charcoal","amount":1},{"item":"item_stone","amount":1}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_scraper_blade","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[{"skill":"skill_life_5_core","minimum":100}],"process":"取一块铁边料，先验锈裂，挑无深裂者入炉。小炉以木炭起火，长柄铁钳夹持边料，观色转亮即移上砧台。锻工手锤反复落打，把边料展宽成薄片，火色一暗便回炉，如此两三回，片身渐匀。薄片边缘留厚，两侧收成可握之形，再以石料粗面平推，磨出平直刮口。全程60分钟，含回炉与磨口间歇。石面磨下的铁屑与炉灰留在原处，不成器物。成件冷后以指腹顺刮口轻试，觉平直无卷刃即可；若口线歪斜或片身过薄，须回炉重展。"},{"id":"recipe_w3_iron_ring","name":"制作圆眼系绳环","aliases":[],"scope":null,"skill":"skill_life_5_core","minimumProficiency":0,"minutes":40,"difficulty":10,"materials":[{"item":"item_iron_scrap","amount":1},{"item":"item_charcoal","amount":1}],"tools":["item_smith_hammer","item_smith_tongs"],"workstation":"smithing","output":{"item":"item_iron_ring","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":["npc_hw_duanyan"],"toolWear":1,"failure":{"recoverFraction":0.25,"injury":2},"prerequisites":[],"process":"把一小块铁边料先验过锈裂，挑无贯穿裂纹的放进小炉，配一袋木炭鼓风加热，等坯料透出亮红再夹出。用长柄铁钳夹稳热坯，在砧台上以锻工手锤反复锤打，把料拉成一根粗细匀顺的条料，中途回炉补温，避免冷打崩边。条料一端趁热弯起，绕着钳口或砧角卷成闭环，两端搭口对齐后重叠加热，再落锤把搭口敲合压实，使接口与环身齐平。整环入炉匀热一次，取出修整圆度，让环眼内壁顺滑、不挂绳。全程约四十分钟，含加热与回温等待，不另出副产物。冷却后即可穿绳收束，安装处另配扣件。"},{"id":"recipe_w3_clay_bowl","name":"制作敞口粗陶碗","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":100,"minutes":720,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_bowl","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":100}],"process":"取一公斤筛过黏土团，先用手掌反复揉压，把团内气泡挤净，直到断面不见细小孔洞。把泥团摔在陶轮盘面中心，拨转轮盘，双手蘸水从团心向外压开，拉出敞口碗壁，壁厚留得匀些，碗口略外撇。停轮后用木片刮去外壁多余泥浆，再拨慢轮，用指腹和竹片修出平整圈足，碗底留一圈细密轮纹。修好的坯放在阴凉通风处完全干透，不可日晒急干。干坯入窑，用两小袋木炭作燃料，起火后渐升窑温，让坯体缓慢受热，烧成后封火缓冷，待窑温自然降下再取碗。素胎无釉，碗身带拉坯留下的细横纹，适合短时盛饭。"},{"id":"recipe_w3_clay_oil_lamp","name":"制作浅腹陶油灯","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":100,"minutes":720,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_oil_lamp","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":100}],"process":"取一公斤筛过黏土团，先在案上反复揉压，把泥里的气泡挤净，揉到断面不见细孔、手感均匀为止。把泥团摔在手拨陶轮盘心，一手拨转轮盘，一手蘸水把泥团拉成低矮的浅腹圆坯，腹壁要薄厚一致，口沿略收。趁泥还湿软，用拇指在口沿一侧向内捏出一道搭芯槽，槽底压平，槽口稍外翻，好让灯芯搭得住。随后修底：把坯体倒扣在轮盘上，旋出一圈平整的底足，让灯盏放得稳。修好的坯放在阴凉通风处慢慢干透，不可晒急，免得开裂。干坯码入窑中烧成，出窑后即为空灯。油与灯芯另备，不在本件之内。"},{"id":"recipe_w3_clay_funnel","name":"制作短颈陶漏斗","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":150,"minutes":780,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_funnel","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":150}],"process":"取一公斤筛过黏土团，先揉匀除气，直到断面不见细密气孔、手感由软塌转为绵实。把泥团按在手拨陶轮中心，拨轮后以掌根压稳，拇指从顶心向下开孔，再向外推成收口圆锥；颈口用指腹轻收，保持短颈内壁通畅，不可捏塌。成形后置于阴处晾干，等坯体由深色转为浅灰、轻叩声发脆，才装入小窑，与两小袋木炭一同缓烧。烧成取出放凉，即成一件短颈陶漏斗，可用于分装颗粒或凉液；窄口易积残渣，用后需及时清理。"},{"id":"recipe_w3_clay_spool","name":"制作双沿陶线轴","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":100,"minutes":720,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_spool","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":100}],"process":"取一公斤筛过黏土团，先在板上反复揉匀除气，揉到切开断面不见气孔为止。把泥团放到手拨陶轮中央，拨转轮盘，用拇指从顶端压出中孔，双手拢住泥壁向上提拉，做成中空短筒。趁泥还湿润，取筒身上部与下部的泥料分别向外压宽，捏出两端外沿；两处接合要压实抹平，指腹顺沿口转一圈，使沿与筒壁连成一体，不留缝隙。成形后置于阴处干坯，等坯体发白、轻叩声脆，再入窑以木炭两小袋烧成。出窑冷透即得一只双沿陶线轴，可收绕线团，交货不附线。"},{"id":"recipe_w3_clay_bead_set","name":"制作串线陶珠组","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":100,"minutes":780,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_bead_set","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":100}],"process":"取一公斤筛过黏土团，先揉匀除气，再均分成十二份，每份搓成小珠。趁泥尚湿软，用细签从珠身对穿刻出穿线孔，孔口抹平，避免孔壁留下裂纹。把十二粒珠散排阴干，不可堆叠挤压，等泥体完全干透再入窑。窑中以两小袋木炭生火，珠粒散排，彼此留出火路，烧至透红后停火，随窑自然冷却再取出。全程约十三小时，其中大半是干燥与冷却的等待。成品为一组十二粒陶珠，绳子另备；孔位是否对正、珠身有无裂口，是这组珠子最要紧的成败处。"},{"id":"recipe_w3_clay_lid","name":"制作平钮陶盖","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":100,"minutes":660,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_lid","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":100}],"process":"取一公斤筛过黏土团，先揉匀除气，再放上手拨陶轮拨转成形。双手把泥团压成圆盖坯，中央捏出一枚平钮，钮面按平不另加装饰；盖缘依素面陶罐口沿留出收缩余量，边转边用指腹收薄，使盖沿与口沿弧度相合。成形后置阴处干透，不可暴晒急干。干坯与两小袋木炭一同入窑，木炭供小炉烧成，火灰留在炉内。烧毕待冷取出，逐只试盖，看盖沿能否落稳、平钮是否好捏；盖合不等于密封。全程约十一小时，含干燥等待。"},{"id":"recipe_w3_clay_dish","name":"制作分格盐碟","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":150,"minutes":720,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_dish","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":150}],"process":"取一公斤筛过黏土团，先在案上揉匀除气，直到断面不见细孔。把手拨陶轮拨转，将泥团按在轮心，用掌根压开成浅碟，碟壁留出均匀厚度。趁泥还湿软，在碟心捏起一道隔棱，把两侧分开，再用指腹从棱根两侧向碟底压紧，使棱与碟身连成一体，免得烧后从根上裂开。成形后置于阴处干燥，待坯体发白、手触不粘再入窑。窑中以两小袋木炭供火，烧成后取出，逐只翻看碟底有无裂纹，底面完好者方作成品。"},{"id":"recipe_w3_clay_flowerpot","name":"制作排水陶花盆","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":100,"minutes":840,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":3}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_flowerpot","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":100}],"process":"取一公斤筛过黏土团，先揉匀除气，再置到手拨陶轮上拨转，拉出高腹盆形，底部留出开孔余地。趁湿在盆沿处卷厚一圈，用指腹抹平接缝，再于盆底穿出排水孔。成形后置于阴凉处缓慢干燥，待坯体硬挺不再变形，入窑烧成。全程约需八百四十分钟，其中大半是干燥与烧成的等待。木炭三小袋供小炉工序，火灰留在炉内。烧成后取出即得排水陶花盆一件，无副产物；育苗要另配土和种子。"},{"id":"recipe_w3_clay_roof_tile","name":"制作叠搭弧瓦","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":150,"minutes":840,"difficulty":15,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_roof_tile","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[{"skill":"skill_life_14_core","minimum":150}],"process":"取一公斤筛过黏土团，先揉匀除气，放在手拨陶轮上拨转，压成带弧度的泥片，边口压出叠搭阶，阶面要平顺，便于上瓦时搭住下一片。压好的弧片摆在阴处，等它干到发硬，不能晒急，免得翘边开裂。干硬后与两小袋木炭一同入窑烧成，出窑即得一片叠搭弧瓦。全程约十四小时，其中大半是阴干等待。烧成的弧瓦用于局部补屋顶，铺盖须配合现有坡面，弧面朝上、叠搭阶顺水搭接，才能挡雨。"},{"id":"recipe_w3_clay_net_weight","name":"制作穿孔陶网坠","aliases":[],"scope":null,"skill":"skill_life_14_core","minimumProficiency":0,"minutes":720,"difficulty":10,"materials":[{"item":"item_clay","amount":1},{"item":"item_charcoal","amount":2}],"tools":["item_pottery_wheel"],"workstation":"pottery","output":{"item":"item_clay_net_weight","quantity":1},"byproducts":[],"learningRequired":true,"learnFee":4,"learnMinutes":60,"teachers":[],"toolWear":1,"failure":{"recoverFraction":0,"injury":0},"prerequisites":[],"process":"取一公斤筛过黏土，在陶轮旁反复揉压，把气团挤净，搓成一头略粗的长卵形泥坯。趁泥还软，用手指从粗端挤开孔道，再从另一面按压校正，使孔道贯通不偏。趁泥湿软，以指腹把孔口两缘抹圆，抹去翻起的毛边，坯面留细密指痕即可。阴处晾至完全干透，再入窑，以两袋共五百克木炭烧至透红，火灰留在炉内。冷却后取出，孔缘无裂、坠身沉实者为成。系在网下缘作配重，网和绳另备。"}]