{
  "$id": "ontology.schema.json",
  "title": "L1 词汇表文件（world/ontology/*.json 与内容包 vocabulary/*.json）",
  "type": "object",
  "required": [
    "kind",
    "namespace",
    "version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "verbs",
        "tags",
        "offenses",
        "holdings",
        "obligations",
        "resources",
        "entity-templates",
        "primitives",
        "derived-fields",
        "calendars",
        "fixtures"
      ]
    },
    "namespace": {
      "$ref": "#/$defs/namespace"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1
    },
    "handoverClasses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/labelled"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourcesAndSinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(src|sink):[a-z_]+$"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "idPrefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+_$"
      }
    },
    "subjectTemplates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/labelled"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties":{"kind":{"const":"calendars"}}},
      "then": {"properties":{"entries":{"items":{"$ref":"#/$defs/calendar"}}}}
    },
    {
      "if": {"properties":{"kind":{"const":"fixtures"}}},
      "then": {"properties":{"entries":{"items":{"$ref":"#/$defs/fixture"}}}}
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verbs"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/verb"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tags"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/tag"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "offenses"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/offense"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "holdings"
          }
        }
      },
      "then": {
        "required": [
          "handoverClasses",
          "subjectTemplates",
          "triggers",
          "reasons"
        ],
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/holding"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "obligations"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/obligation"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "resources"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/resource"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "entity-templates"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/template"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "derived-fields"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/derivedField"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "primitives"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/primitive"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fixture": {
      "type":"object",
      "required":["id","label","affords"],
      "properties": {
        "id":{"type":"string","pattern":"^[a-z][a-z_]*$"},
        "label":{"type":"string","minLength":1},
        "affords":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "calendar": {
      "type":"object",
      "required":["id","epochMinute","months","rateBasis"],
      "properties": {
        "id":{"type":"string","minLength":1},
        "epochMinute":{"type":"integer"},
        "months":{"type":"array","minItems":1,"items":{"type":"object","required":["id","days"],"properties":{"id":{"type":"string"},"days":{"type":"integer","minimum":1}},"additionalProperties":false}},
        "leap":{"type":"object","required":["cycle","years","afterMonth","days","obligationsSkip"],"properties":{"cycle":{"type":"integer","minimum":1},"years":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1}},"afterMonth":{"type":"integer","minimum":1},"days":{"type":"integer","minimum":1},"obligationsSkip":{"type":"boolean"}},"additionalProperties":false},
        "rateBasis":{"type":"object","required":["month","year"],"properties":{"month":{"type":"integer","minimum":1},"year":{"type":"integer","minimum":1}},"additionalProperties":false}
      },
      "additionalProperties":false
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\s,]+$"
    },
    "labelled": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verb": {
      "type": "object",
      "required": [
        "id",
        "label",
        "family"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "family": {
          "enum": [
            "social",
            "code",
            "tool",
            "primitive",
            "design",
            "pack"
          ]
        },
        "note": {
          "type": "string"
        },
        "broader": {
          "type": "string",
          "description": "上位词（12 §12.3.3）；包词汇必填"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "enum": [
            "core",
            "shared",
            "private"
          ]
        },
        "definition": {
          "type": "string"
        },
        "distinctFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tag": {
      "type": "object",
      "required": [
        "id",
        "family",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "family": {
          "type": "string"
        },
        "source": {
          "enum": [
            "code",
            "design",
            "pack"
          ]
        },
        "pattern": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "broader": {
          "type": "string",
          "description": "上位词（12 §12.3.3）；包词汇必填"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "enum": [
            "core",
            "shared",
            "private"
          ]
        },
        "definition": {
          "type": "string"
        },
        "distinctFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "offense": {
      "type": "object",
      "required": [
        "id",
        "label",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$|^[a-z][a-z0-9_-]*:[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "enum": [
            "template",
            "code",
            "design",
            "pack"
          ]
        },
        "note": {
          "type": "string"
        },
        "broader": {
          "type": "string",
          "description": "上位词（12 §12.3.3）；包词汇必填"
        },
        "act": {
          "type": "string",
          "description": "构成该罪的行为类别（K6）：take/destroy/gather/use/enter/cast/detain"
        },
        "against": {
          "type": "object",
          "description": "行为对象须具备的属性；越具体越优先（K6）"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "enum": [
            "core",
            "shared",
            "private"
          ]
        },
        "definition": {
          "type": "string"
        },
        "distinctFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "handover": {
      "type": "object",
      "required": [
        "gone",
        "vacated",
        "defected"
      ],
      "properties": {
        "gone": {
          "enum": [
            "vacate",
            "stay",
            "succeed",
            "estate",
            "close",
            "revert",
            "retain_disputed",
            "suspend",
            null
          ]
        },
        "vacated": {
          "enum": [
            "vacate",
            "stay",
            "succeed",
            "estate",
            "close",
            "revert",
            "retain_disputed",
            "suspend",
            null
          ]
        },
        "defected": {
          "enum": [
            "vacate",
            "stay",
            "succeed",
            "estate",
            "close",
            "revert",
            "retain_disputed",
            "suspend",
            null
          ]
        }
      },
      "additionalProperties": false,
      "description": "必填三项（I5）：holder.gone、self.closed(vacated)、holder.holdingClosed(member_of, defected) 的钩子模板；null 即附录 A 的“—”"
    },
    "holding": {
      "type": "object",
      "required": [
        "id",
        "label",
        "holderKinds",
        "subjectKinds",
        "exclusive",
        "handover",
        "onSubjectGone",
        "hooks",
        "concluded",
        "functional",
        "derives",
        "visibility",
        "pins",
        "contest",
        "incompatibleWith"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "holderKinds": {
          "$ref": "#/$defs/templates"
        },
        "subjectKinds": {
          "$ref": "#/$defs/templates"
        },
        "exclusive": {
          "type": "boolean"
        },
        "sum": {
          "type": "number"
        },
        "handover": {
          "$ref": "#/$defs/handover"
        },
        "visibility": {
          "enum": [
            "public",
            "parties",
            "members",
            "private"
          ]
        },
        "note": {
          "type": "string"
        },
        "broader": {
          "type": "string",
          "description": "上位词（12 §12.3.3）；包词汇必填"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "enum": [
            "core",
            "shared",
            "private"
          ]
        },
        "definition": {
          "type": "string"
        },
        "distinctFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capacity": {
          "type": "string",
          "description": "受标的事实约束的容量（lodges：节点 capacity）"
        },
        "grantedBy": {
          "$ref": "#/$defs/templates"
        },
        "onSubjectGone": {
          "enum": [
            "close",
            "stay",
            "estate",
            "reparent"
          ]
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "on",
              "do"
            ],
            "properties": {
              "on": {
                "type": "string",
                "pattern": "^(holder\\.gone|self\\.closed|holder\\.holdingClosed|subject\\.gone|subject\\.transferred|event)(\\(.*\\))?$"
              },
              "when": {
                "type": "string"
              },
              "do": {
                "anyOf": [
                  {
                    "enum": [
                      "vacate",
                      "stay",
                      "succeed",
                      "estate",
                      "close",
                      "revert",
                      "retain_disputed",
                      "reparent"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "op"
                      ],
                      "properties": {
                        "op": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "concluded": {
          "type": "boolean",
          "description": "开立时由内核写缔结快照 {place, lawVersion, time, form, inName?}"
        },
        "transferable": {
          "type": "boolean",
          "description": "Whether an authorized holding.transfer may assign this kind"
        },
        "functional": {
          "type": "boolean",
          "description": "职能读 effective(holding)（附录 A §A.15.25）"
        },
        "derives": {
          "type": "object",
          "properties": {
            "authority": {
              "type": "boolean"
            },
            "title": {
              "type": "boolean"
            },
            "quota": {
              "type": "boolean"
            },
            "salary": {
              "type": "boolean"
            },
            "schedule": {
              "type": "boolean"
            },
            "services": {
              "type": "boolean"
            },
            "conduction": {
              "type": "boolean"
            },
            "voting": {
              "type": "boolean"
            },
            "presence": {
              "type": "boolean"
            },
            "access": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "pins": {
          "enum": [
            "none",
            "holder",
            "subject",
            "both"
          ]
        },
        "contest": {
          "enum": [
            "lottery",
            "price",
            "arrival",
            "rank",
            null
          ]
        },
        "incompatibleWith": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "policy"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "variant": {
                "type": "string"
              },
              "subjectFilter": {
                "type": "string"
              },
              "policy": {
                "enum": [
                  "forbid",
                  "auto_vacate",
                  "needs_permission",
                  "flag"
                ]
              },
              "permit": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "parent": {
          "type": "string"
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "pins": {
                "enum": [
                  "none",
                  "holder",
                  "subject",
                  "both"
                ]
              },
              "contest": {
                "enum": [
                  "lottery",
                  "price",
                  "arrival",
                  "rank",
                  null
                ]
              },
              "concluded": {
                "type": "boolean"
              },
              "incompatibleWith": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "policy"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "variant": {
                      "type": "string"
                    },
                    "subjectFilter": {
                      "type": "string"
                    },
                    "policy": {
                      "enum": [
                        "forbid",
                        "auto_vacate",
                        "needs_permission",
                        "flag"
                      ]
                    },
                    "permit": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "label",
        "schedule",
        "onDebtorGone",
        "onCreditorGone"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "schedule": {
          "enum": [
            "single",
            "installments",
            "monthly",
            "periodic",
            "continuous",
            "condition"
          ]
        },
        "handover": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "broader": {
          "type": "string",
          "description": "上位词（12 §12.3.3）；包词汇必填"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "enum": [
            "core",
            "shared",
            "private"
          ]
        },
        "definition": {
          "type": "string"
        },
        "distinctFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "onDebtorGone": {
          "enum": [
            "accelerate",
            "assume_by_heirs",
            "substitute_performance",
            "void",
            "pursue"
          ]
        },
        "onCreditorGone": {
          "enum": [
            "estate",
            "heirs",
            "void"
          ]
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "label",
        "family",
        "unit"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "family": {
          "enum": [
            "currency",
            "stock",
            "index",
            "item"
          ]
        },
        "unit": {
          "type": "string"
        },
        "pattern": {
          "type": "boolean"
        },
        "money": {
          "type": "object",
          "description": "铸币事实（01 §1.6、15 §15.3）：金属、成色、发行者；item 为尚按物品记账的铸币模板",
          "required": [
            "metal",
            "fineness",
            "issuer"
          ],
          "properties": {
            "metal": {
              "enum": [
                "copper",
                "silver",
                "gold",
                "none"
              ]
            },
            "fineness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "issuer": {
              "type": "string"
            },
            "coinage": {
              "type": "string"
            },
            "item": {
              "type": "string"
            },
            "backedBy": {
              "type": "object",
              "required": [
                "coin",
                "ratio"
              ],
              "properties": {
                "coin": {
                  "type": "string"
                },
                "ratio": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "ledger": {
          "type": "boolean",
          "description": "S1a：已经入账本（账户与转移）的资源"
        },
        "note": {
          "type": "string"
        },
        "broader": {
          "type": "string",
          "description": "上位词（12 §12.3.3）；包词汇必填"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "enum": [
            "core",
            "shared",
            "private"
          ]
        },
        "definition": {
          "type": "string"
        },
        "distinctFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": [
        "id",
