    "T3"
  ],
  "turns": [
    {
      "input": "我步行去北林边找吴朔。",
      "assertions": [
        {
          "kind": "equals",
          "path": "state.location",
          "value": "loc_hw_northwood"
        }
      ]
    },
    {
      "input": "我问吴朔愿不愿意带我去北林废观测塔，先等他答复。",
      "assertions": [
        {
          "kind": "delta",
          "path": "state.player.coins",
          "value": 0
        }
      ]
    },
    {
      "input": "那就出发，请吴朔带路，我们一起走到北林废观测塔后停下。",
      "assertions": [
        {
          "kind": "equals",
          "path": "state.location",
          "value": "site_beilin_tower"
        },
        {
          "kind": "equals",
          "path": "state.npcs.npc_hw_wushuo.location",
          "value": "site_beilin_tower"
        },
        {
          "kind": "records",
          "path": "state.obligations",
          "where": {
            "status": "已完成"
          },
          "min": 1
        }
      ]
    },
    {
      "input": "我只看看塔外的石头，不进去，不拿东西。",
      "assertions": [
        {
          "kind": "unchanged",
          "paths": [
            "state.inventory",
            "state.player.coins"
          ]
        }
      ]
    },
    {
      "input": "我想不花时间立刻瞬移到王都；如果办不到就留在这里。",
      "assertions": [
        {
          "kind": "equals",
          "path": "state.location",
          "value": "site_beilin_tower"
        },
        {
          "kind": "delta",
          "path": "state.player.coins",
          "value": 0
        }
      ]
    },
    {
      "input": "我告别后步行回河湾村，不接别的委托。",
      "assertions": [
        {
          "kind": "equals",
          "path": "state.location",
          "value": "loc_hw"
        }
      ]
    },
    {
      "input": "我从河湾村步行去白石镇，只赶路，到镇上便停。",
      "assertions": [
        {
          "kind": "equals",
          "path": "state.location",
          "value": "loc_bs"
        },
        {
          "kind": "elapsed",
          "min": 300,
          "max": 1200
        }
      ]
    },
    {
      "input": "（场外）这趟到白石镇实际花了多久，我现在在哪？",
      "assertions": [
        {
          "kind": "equals",
          "path": "state.location",
          "value": "loc_bs"
        },
        {
          "kind": "elapsed",
          "min": 0,
          "max": 0
        }
      ]
    }
  ],
