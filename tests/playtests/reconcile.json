{
  "id": "reconcile",
  "title": "重生成、修改玩家消息、删除与重新载入",
  "requirements": [
    "L6",
    "M6",
    "M7",
    "M8"
  ],
  "turns": [
    {
      "input": "我走进青灯酒馆。",
      "assertions": [
        {
          "kind": "equals",
          "path": "state.location",
          "value": "bld_hw_qingdeng"
