          "value": "bld_hw_mill"
        }
      ],
      "expectedTools": [
        "world_move"
      ]
    },
    {
      "input": "我向阿砚买一把削木小刀和两份木料，按正常价格付钱拿货。",
      "assertions": [
        {
          "kind": "delta",
          "path": "state.inventory.item_whittling_knife.quantity",
          "value": 1
