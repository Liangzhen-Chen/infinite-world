          "else": [
            {
              "kind": "calls",
              "tool": "world_learn",
              "args": {},
              "min": 1
            },
            {
              "kind": "delta",
              "path": "state.player.coins",
              "value": -4
            }
          ]
        }
      ]
    },
    {
