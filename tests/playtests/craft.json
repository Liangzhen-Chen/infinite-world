      "assertions": [
        {
          "kind": "conditional",
          "when": {
            "path": "state.recipes.recipe_wooden_pegs"
          },
          "then": [
            {
              "kind": "delta",
              "path": "state.player.coins",
              "value": 0
            }
          ],
          "else": [
            {
              "kind": "calls",
