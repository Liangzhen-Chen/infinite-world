{
  "name": "infinite-fields",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/accept/*.test.mjs\"",
    "accept": "node tools/accept/run.mjs pre_commit",
    "test:kernel": "node --test \"tests/kernel/*.test.mjs\"",
    "snapshot": "node tools/gen-status-snapshot.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:all": "node --test \"tests/accept/*.test.mjs\" \"tests/kernel/*.test.mjs\" && node --test --test-concurrency=1 \"tests/acceptance/**/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "acorn": "8.19.0",
    "express": "4.22.1",
    "fast-check": "4.3.0",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "opencc-js": "^1.4.2",
    "yaml": "2.8.3"
  }
}
